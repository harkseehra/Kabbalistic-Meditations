---
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}`, label: 'today' },
  { href: `${base}practice/`, label: 'practice' },
  { href: `${base}prayer/`, label: 'prayer' },
];
const current = Astro.url.pathname;
---

<header id="site-header">
  <a class="site-name" href={base}>
    <span class="site-wordmark">KABBALISTIC MEDITATIONS<span class="cursor">▌</span></span>
  </a>
  <nav>
    {nav.map(({ href, label }) => {
      const isActive = current === href || current === href.replace(/\/$/, '');
      return (
        <a
          href={href}
          class:list={[{ active: isActive }]}
          style={isActive ? 'view-transition-name: active-nav' : undefined}
        >
          {label}
        </a>
      );
    })}
  </nav>
</header>

<!-- Day/night switch: a plain side button on the right edge of the screen, vertically centred -->
<button class="theme-toggle" id="theme-toggle" transition:persist="theme-toggle" aria-label="Toggle day and night mode" title="Toggle day and night mode">
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g fill="currentColor"><path d="M11.17 6.06 12.83 6.06 12 2.5Z"/><path d="M15.61 7.21 16.79 8.39 18.72 5.28Z"/><path d="M17.94 11.17 17.94 12.83 21.5 12Z"/><path d="M16.79 15.61 15.61 16.79 18.72 18.72Z"/><path d="M12.83 17.94 11.17 17.94 12 21.5Z"/><path d="M8.39 16.79 7.21 15.61 5.28 18.72Z"/><path d="M6.06 12.83 6.06 11.17 2.5 12Z"/><path d="M7.21 8.39 8.39 7.21 5.28 5.28Z"/></g></svg>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/><path fill="currentColor" d="M18.5 3.5 19.2 5.3 21 6 19.2 6.7 18.5 8.5 17.8 6.7 16 6 17.8 5.3Z"/></svg>
</button>

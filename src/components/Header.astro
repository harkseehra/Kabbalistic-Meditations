---
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}`, label: 'today' },
  { href: `${base}practice/`, label: 'practice' },
  { href: `${base}prayer/`, label: 'prayer' },
];
const current = Astro.url.pathname;
---

<header id="site-header">
  <a class="site-name" href={base}>
    <span class="site-wordmark">KABBALISTIC MEDITATIONS<span class="cursor">▌</span></span>
  </a>
  <nav>
    {nav.map(({ href, label }) => (
      <a href={href} class:list={[{ active: current === href || current === href.replace(/\/$/, '') }]}>
        {label}
      </a>
    ))}
  </nav>
  <div class="header-controls">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle day and night mode" title="Toggle day and night mode">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="18.7" y1="5.3" x2="16.9" y2="7.1"/><line x1="21.5" y1="12" x2="19" y2="12"/><line x1="18.7" y1="18.7" x2="16.9" y2="16.9"/><line x1="12" y1="21.5" x2="12" y2="19"/><line x1="5.3" y1="18.7" x2="7.1" y2="16.9"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="5.3" y1="5.3" x2="7.1" y2="7.1"/></g></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</header>

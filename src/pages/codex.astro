    <script id="gematria-data" type="application/json" set:html={JSON.stringify(GEMATRIA)}></script>
    <script>
      // Gematria shapes — the value drawn as points on a circle, from
      // the shared letters file. The doubles cards carry their letter
      // in data-shape; the table rows take the Hebrew name from the
      // Hebrew cell. Restored rows are skipped: their values are the
      // restored sounds', not the Hebrew letter's gematria.
      (function () {
        var GEMATRIA = JSON.parse(document.getElementById('gematria-data').textContent);
        function shapeSVG(n, size) {
          var s = size || (n > 10 ? 60 : 44);
          var c = s / 2, r = s / 2 - 4;
          var pts = [];
          for (var i = 0; i < n; i++) {
            var a = -Math.PI / 2 + i * 2 * Math.PI / n;
            pts.push([c + r * Math.cos(a), c + r * Math.sin(a)]);
          }
          var dotR = n > 100 ? 1.5 : n > 20 ? 2 : 3;
          var inner = '';
          if (n === 2) {
            inner += '<line x1="' + pts[0][0].toFixed(1) + '" y1="' + pts[0][1].toFixed(1) + '" x2="' + pts[1][0].toFixed(1) + '" y2="' + pts[1][1].toFixed(1) + '" stroke="currentColor" stroke-width="1.5"/>';
          } else if (n > 2 && n <= 10) {
            inner += '<polygon points="' + pts.map(function (p) { return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ') + '" fill="none" stroke="currentColor" stroke-width="1.5"/>';
          }
          pts.forEach(function (p) {
            inner += '<circle cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="' + dotR + '" fill="currentColor"/>';
          });
          return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 ' + s + ' ' + s + '" aria-hidden="true">' + inner + '</svg>';
        }
        document.querySelectorAll('.shape-mark[data-shape]').forEach(function (el) {
          var n = GEMATRIA[el.getAttribute('data-shape')] || 0;
          if (n) el.innerHTML = shapeSVG(n, 36);
        });
        document.querySelectorAll('table.codex tbody tr:not([data-group="restored"])').forEach(function (tr) {
          var hebCell = tr.children[2];
          var name = hebCell.textContent.trim().split(/\s+/).pop();
          var n = GEMATRIA[name] || 0;
          if (!n) return;
          var valCell = tr.children[4];
          valCell.innerHTML = '<span class="gem-fact"><span class="shape-mark">' + shapeSVG(n, 28) + '</span><span>' + valCell.textContent.trim() + '</span></span>';
        });
      })();
    </script>
    <script>
      // Codex filters — the chips filter by group; they are a filter, not the order.
      (function () {
        var chips = document.querySelectorAll('.filters .chip');
        var rows = document.querySelectorAll('table.codex tbody tr');
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
            chip.setAttribute('aria-pressed', 'true');
            var f = chip.getAttribute('data-filter');
            rows.forEach(function (row) {
              row.hidden = f !== 'all' && row.getAttribute('data-group') !== f;
            });
          });
        });
      })();
    </script>
    <script>
      (function () {
        var header = document.getElementById('site-header');
        var toggle = document.getElementById('nav-toggle');
        if (!header || !toggle) return;
        toggle.addEventListener('click', function () {
          var open = header.classList.toggle('nav-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        header.querySelectorAll('nav a').forEach(function (a) {
          a.addEventListener('click', function () {
            header.classList.remove('nav-open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      })();
    </script>
    <script>
      // Day/night switch: same behaviour as the BaseLayout pages — the
      // saved choice wins, otherwise the system preference; the toggle
      // flips it and persists the choice under the same 'theme' key, so
      // the setting carries across every page.
      (function () {
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) return;
        function currentTheme() {
          return root.getAttribute('data-theme') || 'day';
        }
        function applyTheme(theme) {
          localStorage.setItem('theme', theme);
          theme === 'night'
            ? root.setAttribute('data-theme', 'night')
            : root.removeAttribute('data-theme');
        }
        toggle.addEventListener('click', function () {
          applyTheme(currentTheme() === 'night' ? 'day' : 'night');
        });
      })();
    </script>

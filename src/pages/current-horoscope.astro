    <title>Current Horoscope</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=IM+Fell+English:ital@0;1&family=Frank+Ruhl+Libre:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2.25rem; }
      * { box-sizing: border-box; }
      :root {
        color-scheme: light dark;
        --bg: #f7f5f0;
        --surface: #ffffff;
        --surface-2: #efede6;
        --ink: #1c1e26;
        --ink-soft: #4a4d59;
        --line: #d8d4c8;
        --accent: #191970;
        --accent-soft: #e3e4f2;
        --heb: #191970;
        --fire: #b34a1f; --fire-bg: #fbe9df;
        --earth: #6d5a2e; --earth-bg: #f1ead3;
        --air: #3e6b7a; --air-bg: #e0eef2;
        --water: #2c4f9e; --water-bg: #e0e8fa;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #172022;
          --surface: #1f2c2e;
          --surface-2: #243335;
          --ink: #ece9df;
          --ink-soft: #b9beb9;
          --line: #3a4a4c;
          --accent: #83adb5;
          --accent-soft: #26383b;
          --heb: #e8c766;
          --fire: #eda27c; --fire-bg: #3a2a22;
          --earth: #d9c48a; --earth-bg: #37321f;
          --air: #9fd3e0; --air-bg: #22383d;
          --water: #a9c2f5; --water-bg: #232f47;
        }
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "IM Fell English", Georgia, serif;
        font-size: 1.06rem;
        line-height: 1.65;
      }
      .wrap { max-width: 1060px; margin: 0 auto; padding: 2rem 1.1rem 3.5rem; }
      h1, h2, h3, .oswald { font-family: "Oswald", "Arial Narrow", sans-serif; }
      h1 { font-size: 2rem; font-weight: 600; letter-spacing: .01em; line-height: 1.2; margin: 0 0 .4rem; }
      h2 { font-size: 1.25rem; font-weight: 600; margin: 2.4rem 0 .7rem; }
      p { margin: 0 0 1rem; max-width: 44rem; }
      .lede { color: var(--ink-soft); font-size: 1.12rem; }
      .heb { font-family: "Frank Ruhl Libre", serif; color: var(--heb); font-weight: 500; }
      .heb-big { font-size: 1.9rem; line-height: 1; }
      .heb-md { font-size: 1.45rem; line-height: 1; }

      /* Site nav */
      .sitenav { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-bottom: 1.6rem; }
      .sitenav a {
        font-family: "Oswald", sans-serif; font-size: .92rem; letter-spacing: .08em; text-transform: uppercase;
        color: var(--ink-soft); text-decoration: none;
      }
      .sitenav a.current { color: var(--accent); }
      .backlink { font-family: "Oswald", sans-serif; font-size: .92rem; letter-spacing: .03em; color: var(--accent); text-decoration: none; display: inline-block; margin-bottom: 1rem; }

      /* Week strip */
      .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: .5rem; margin: 1.2rem 0 .4rem; }
      .day {
        background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
        padding: .6rem .4rem .5rem; text-align: center;
      }
      .day .dname { font-family: "Oswald", sans-serif; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); display: block; }
      .day .pname { display: block; font-size: .98rem; margin-top: .15rem; }
      .day .gate { display: block; font-size: .86rem; color: var(--ink-soft); margin-top: .1rem; }
      .day .heb-big { display: block; margin-top: .3rem; }
      @media (max-width: 640px) { .week { grid-template-columns: repeat(4, 1fr); } }

      /* Today */
      .today-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; margin: 1rem 0 .6rem; }
      @media (max-width: 640px) { .today-grid { grid-template-columns: repeat(2, 1fr); } }

      /* Strongest day panel */
      .strongest {
        background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
        padding: 1rem 1.1rem; margin: 1rem 0 .6rem;
      }
      .strongest .chain { font-family: "Oswald", sans-serif; font-size: 1.22rem; font-weight: 600; letter-spacing: .02em; margin: 0 0 .3rem; }
      .strongest p { margin-bottom: .3rem; }
      .strongest p:last-child { margin-bottom: 0; }

      /* Three mothers */
      .mothers { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin: 1rem 0 .6rem; }
      @media (max-width: 640px) { .mothers { grid-template-columns: 1fr; } }

      /* Filters */
      .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.4rem 0 1rem; align-items: center; }
      .filters span { font-family: "Oswald", sans-serif; font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); margin-right: .2rem; }
      .chip {
        font-family: "Oswald", sans-serif; font-size: .92rem; letter-spacing: .03em;
        padding: .45rem .95rem; border-radius: 999px; cursor: pointer;
        border: 1px solid var(--line); background: var(--surface); color: var(--ink);
        min-height: 2.5rem;
      }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
      @media (prefers-color-scheme: dark) { .chip[aria-pressed="true"] { color: #172022; } }

      /* Table */
      .table-scroll { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--surface); }
      table { width: 100%; border-collapse: collapse; }
      thead th {
        font-family: "Oswald", sans-serif; font-weight: 500; font-size: .82rem; letter-spacing: .09em; text-transform: uppercase;
        text-align: left; color: var(--ink-soft); background: var(--surface-2);
        padding: .7rem .9rem; border-bottom: 1px solid var(--line);
      }
      tr.elem-row td {
        background: var(--surface-2); padding: .7rem .9rem; border-top: 2px solid var(--line);
        font-family: "Oswald", sans-serif; font-size: 1.05rem; font-weight: 600; letter-spacing: .02em;
      }
      tr.elem-row:first-child td { border-top: none; }
      tr.elem-row .elem-sub { font-family: "IM Fell English", Georgia, serif; font-size: .95rem; font-weight: 400; color: var(--ink-soft); letter-spacing: 0; }
      tr.planet-row td {
        background: var(--accent-soft); padding: .85rem .9rem; border-top: 2px solid var(--line);
      }
      tr.planet-row:first-child td { border-top: none; }
      .planet-name { font-family: "Oswald", sans-serif; font-size: 1.22rem; font-weight: 600; letter-spacing: .02em; }
      .planet-day { color: var(--ink-soft); font-size: .98rem; }
      .planet-letter-cell { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
      .planet-letter-cell .lname { font-size: 1.05rem; }
      .planet-gate { color: var(--ink-soft); font-size: .98rem; }
      .athome {
        font-family: "Oswald", sans-serif; font-size: .82rem; letter-spacing: .07em; text-transform: uppercase;
        padding: .28rem .7rem; border-radius: 999px; white-space: nowrap;
        background: var(--accent); color: #fff;
      }
      @media (prefers-color-scheme: dark) { .athome { color: #172022; } }
      tr.sign-row td { padding: .75rem .9rem; border-top: 1px solid var(--line); vertical-align: middle; }
      tr.sign-row td:first-child { padding-left: 2.2rem; }
      .sign-name { font-size: 1.1rem; }
      .sign-letter-cell { display: flex; align-items: center; gap: .6rem; }
      .elem {
        display: inline-block; font-family: "Oswald", sans-serif; font-size: .82rem; letter-spacing: .07em; text-transform: uppercase;
        padding: .28rem .7rem; border-radius: 999px; white-space: nowrap;
      }
      .elem-fire { background: var(--fire-bg); color: var(--fire); }
      .elem-earth { background: var(--earth-bg); color: var(--earth); }
      .elem-air { background: var(--air-bg); color: var(--air); }
      .elem-water { background: var(--water-bg); color: var(--water); }
      tr.reading-row td, tr.empty-row td {
        padding: .7rem .9rem .8rem 2.2rem; border-top: 1px solid var(--line);
        color: var(--ink-soft); font-size: .98rem; font-style: italic;
      }
      tr.hidden-row { display: none; }
      .dimmed { opacity: .35; }

      .note { color: var(--ink-soft); font-size: .98rem; }
      .src { border-top: 1px solid var(--line); margin-top: 2.6rem; padding-top: 1.1rem; color: var(--ink-soft); font-size: .95rem; }
      .src p { margin-bottom: .5rem; }

      /* Mobile: table becomes stacked blocks */
      @media (max-width: 680px) {
        table, thead, tbody, tr, td { display: block; width: 100%; }
        thead { display: none; }
        tr.elem-row td { border-top: 2px solid var(--line); }
        tr.planet-row td { border-top: 2px solid var(--line); }
        tr.sign-row { border-top: 1px solid var(--line); padding: .7rem .9rem .8rem 1.4rem; }
        tr.sign-row td { border-top: none; padding: .12rem 0; }
        tr.sign-row td:first-child { padding-left: 0; }
        tr.sign-row td::before {
          content: attr(data-label); display: inline-block; min-width: 6.2rem;
          font-family: "Oswald", sans-serif; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft);
        }
        tr.sign-row td.cell-sign::before { content: ""; min-width: 0; }
        .sign-name { font-size: 1.2rem; }
        tr.reading-row td, tr.empty-row td { padding-left: 1.4rem; }
      }
    </style>

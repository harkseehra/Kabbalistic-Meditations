        /* ---- Ephemeris: low-precision planetary positions (Schlyter) ---- */
        var ORBIT = {
          Mercury: { a: [0.38709927, 0.00000037], e: [0.20563593, 0.00001906], i: [-7.00497902, -0.00594749], L: [252.25032350, 149472.67411175], lp: [77.45779628, 0.16047689], om: [48.33076593, -0.12534081] },
          Venus:   { a: [0.72333566, 0.00000390], e: [0.00677672, -0.00004107], i: [3.39467605, -0.00078890], L: [181.97909950, 58517.81538729], lp: [131.60246718, 0.00268329], om: [76.67984255, -0.27769418] },
          Earth:   { a: [1.00000261, 0.00000562], e: [0.01671123, -0.00004392], i: [-0.00001531, -0.01294668], L: [100.46457166, 35999.37244981], lp: [102.93768193, 0.32327364], om: [0.0, 0.0] },
          Mars:    { a: [1.52371034, 0.00001847], e: [0.09339410, 0.00007882], i: [1.84969142, -0.00813131], L: [-4.55343205, 19140.30268499], lp: [-23.94362959, 0.44441088], om: [49.55953891, -0.29257343] },
          Jupiter: { a: [5.20288700, -0.00011607], e: [0.04838624, -0.00013253], i: [1.30439695, -0.00183714], L: [34.39644051, 3034.74612775], lp: [14.72847983, 0.21252668], om: [100.47390909, 0.20469106] },
          Saturn:  { a: [9.53667594, -0.00125060], e: [0.05386179, -0.00050991], i: [2.48599187, 0.00193609], L: [49.95424423, 1222.49362201], lp: [92.59887831, -0.41897216], om: [113.66242448, -0.28867794] }
        };
        var RAD = Math.PI / 180, DEG = 180 / Math.PI;
        function norm360(x) { return ((x % 360) + 360) % 360; }
        function helio(el, T) {
          var a = el.a[0] + el.a[1] * T, e = el.e[0] + el.e[1] * T, i = (el.i[0] + el.i[1] * T) * RAD;
          var L = norm360(el.L[0] + el.L[1] * T), lp = norm360(el.lp[0] + el.lp[1] * T), om = norm360(el.om[0] + el.om[1] * T);
          var w = (lp - om) * RAD, M = norm360(L - lp), Mr = M * RAD;
          var E = M + DEG * e * Math.sin(Mr) * (1 + e * Math.cos(Mr));
          for (var k = 0; k < 10; k++) {
            var Er = E * RAD;
            E = E - (E - DEG * e * Math.sin(Er) - M) / (1 - e * Math.cos(Er));
          }
          var Er2 = E * RAD;
          var xv = a * (Math.cos(Er2) - e), yv = a * Math.sqrt(1 - e * e) * Math.sin(Er2);
          var cw = Math.cos(w), sw = Math.sin(w), co = Math.cos(om * RAD), so = Math.sin(om * RAD), ci = Math.cos(i), si = Math.sin(i);
          var xh = (cw * co - sw * so * ci) * xv + (-sw * co - cw * so * ci) * yv;
          var yh = (cw * so + sw * co * ci) * xv + (-sw * so + cw * co * ci) * yv;
          var zh = (sw * si) * xv + (cw * si) * yv;
          return { x: xh, y: yh, z: zh, lon: norm360(Math.atan2(yh, xh) * DEG) };
        }
        function geoLon(planet, T, earth) {
          var h = helio(ORBIT[planet], T);
          return norm360(Math.atan2(h.y - earth.y, h.x - earth.x) * DEG);
        }
        function dayNumber(y, m, d, ut) {
          return 367 * y - Math.floor(7 * (y + Math.floor((m + 9) / 12)) / 4) + Math.floor(275 * m / 9) + d - 730530 + ut / 24;
        }

        /* ---- Work out today ---- */
        function set(id, text) { var el = document.getElementById(id); if (el) el.textContent = text; }
        var now = new Date();
        var d = dayNumber(now.getUTCFullYear(), now.getUTCMonth() + 1, now.getUTCDate(), now.getUTCHours() + now.getUTCMinutes() / 60);
        var T = d / 36525;
        var earth = helio(ORBIT.Earth, T);
        var sunLon = norm360(earth.lon + 180);
        var moonLonVal = moonLon(now);
        var day = DAYS[now.getDay()];
        var sun = SIGNS[sunSignIndex(now)];
        var moon = SIGNS[Math.floor(moonLonVal / 30) % 12];

        set('today-date', now.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' — the day letter, the sun letter, the moon letter, and the holy name of the day.');
        set('today-day-heb', day.heb);
        set('today-day-name', day.letter);
        set('today-day-sub', day.weekday + ' — ' + day.planet);
        set('today-sun-heb', sun.heb);
        set('today-sun-name', sun.letter);
        set('today-sun-sub', 'Sun in ' + sun.name);
        set('today-moon-heb', moon.heb);
        set('today-moon-name', moon.letter);
        set('today-moon-sub', 'Moon in ' + moon.name);
        set('today-holy-heb', day.holyHeb);
        set('today-holy-name', day.holy);
        set('today-holy-sub', day.weekday);

        /* ---- The seven planets as they stand ---- */
        function planetEntry(planet, lon) {
          var dbl = null;
          for (var i = 0; i < DAYS.length; i++) if (DAYS[i].planet === planet) dbl = DAYS[i];
          var signIdx = Math.floor(lon / 30) % 12;
          return { planet: planet, dbl: dbl, sign: SIGNS[signIdx], deg: lon % 30 };
        }
        var planets = [
          planetEntry('Saturn', geoLon('Saturn', T, earth)),
          planetEntry('Jupiter', geoLon('Jupiter', T, earth)),
          planetEntry('Mars', geoLon('Mars', T, earth)),
          planetEntry('Sun', sunLon),
          planetEntry('Venus', geoLon('Venus', T, earth)),
          planetEntry('Mercury', geoLon('Mercury', T, earth)),
          planetEntry('Moon', moonLonVal)
        ];

        /* ---- This month's strongest day ---- */
        var sunSign = SIGNS[Math.floor(sunLon / 30) % 12];
        var sunRuler = RULERS[sunSign.name];
        var rulerDay = null;
        for (var i = 0; i < DAYS.length; i++) if (DAYS[i].planet === sunRuler) rulerDay = DAYS[i];
        var sunDbl = null;
        for (var j = 0; j < DAYS.length; j++) if (DAYS[j].planet === 'Sun') sunDbl = DAYS[j];
        set('strongest-chain', rulerDay.weekday + ' - Sun - ' + sunDbl.letter + ' - ' + sunSign.name + ' - ' + sunSign.letter);
        set('strongest-note', rulerDay.weekday + ' is the month\u2019s strongest day. The Sun is in ' + sunSign.name + ', ' + sunRuler + '\u2019s sign, so ' + sunRuler + '\u2019s day rules this month. The Sun\u2019s own day, for meditating ' + sunDbl.letter + ' + ' + sunSign.letter + ', is ' + sunDbl.weekday + '.');

        /* ---- Build the transit chart, grouped by element ---- */
        function esc(s) { return s; }
        var html = '';
        ELEMENTS.forEach(function (el) {
          var group = planets.filter(function (p) { return p.sign.element === el.key; });
          html += '<tr class="elem-row" data-element="' + el.key + '"><td colspan="7">' + el.label + ' &nbsp;<span class="elem-sub">' + el.sub + '</span></td></tr>';
          if (group.length === 0) {
            html += '<tr class="empty-row" data-element="' + el.key + '"><td colspan="7">No planet in ' + el.label + ' today.</td></tr>';
            return;
          }
          group.forEach(function (p) {
            var atHome = RULED_SIGNS[p.planet].indexOf(p.sign.name) !== -1;
            var cusp = (p.deg < 1 || p.deg > 29) ? ' <span class="planet-gate">near the cusp</span>' : '';
            html += '<tr class="planet-row" data-element="' + el.key + '">'
              + '<td colspan="4"><span class="planet-name">' + p.planet + '</span> &nbsp;<span class="planet-day">— meditate ' + p.dbl.weekday + '</span>'
              + (atHome ? ' <span class="athome">At home — doubled</span>' : '')
              + '</td>'
              + '<td colspan="3"><span class="planet-letter-cell"><span class="lname">Planet letter — ' + p.dbl.letter + ', the double</span><span class="heb heb-big">' + p.dbl.heb + '</span><span class="planet-gate">Gate — ' + p.dbl.gate + '</span></span></td>'
              + '</tr>';
            html += '<tr class="sign-row" data-element="' + el.key + '">'
              + '<td class="cell-sign"><span class="sign-name">' + p.sign.name + ' ' + p.deg.toFixed(0) + '°</span>' + cusp + '</td>'
              + '<td data-label="Dates">' + p.sign.dates + '</td>'
              + '<td data-label="Letter"><span class="sign-letter-cell">' + p.sign.letter + ' <span class="heb heb-md">' + p.sign.heb + '</span></span></td>'
              + '<td data-label="Body part">' + p.sign.organ + '</td>'
              + '<td data-label="Sense">' + p.sign.sense + '</td>'
              + '<td data-label="Element"><span class="elem elem-' + el.key + '">' + el.label + '</span></td>'
              + '<td data-label="Mother"><span class="sign-letter-cell">' + p.sign.mother + ' <span class="heb heb-md">' + p.sign.motherHeb + '</span></span></td>'
              + '</tr>';
            if (p.planet === 'Saturn' && p.sign.name === 'Aries') {
              html += '<tr class="reading-row" data-element="' + el.key + '"><td colspan="7">Reading — my own experience, not the teaching: speech is deciding life and death in this transit.</td></tr>';
            }
          });
        });
        document.getElementById('transit-body').innerHTML = html;

        /* ---- Element filter ---- */
        var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
        function apply(filter) {
          var rows = Array.prototype.slice.call(document.querySelectorAll('#transit-table tbody tr'));
          rows.forEach(function (r) {
            r.classList.toggle('hidden-row', filter !== 'all' && r.dataset.element !== filter);
          });
        }
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
            chip.setAttribute('aria-pressed', 'true');
            apply(chip.dataset.filter);
          });
        });
      })();
    </script>
  </body>
</html>

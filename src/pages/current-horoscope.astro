          { name: 'Sagittarius', letter: 'Samekh', heb: 'ס', dates: 'Nov 22 – Dec 21', organ: 'Bile',          sense: 'Excitement',    element: 'fire',  mother: 'Shin', motherHeb: 'ש' },
          { name: 'Capricorn',   letter: 'Ayin',   heb: 'ע', dates: 'Dec 22 – Jan 19', organ: 'First stomach', sense: 'Play',          element: 'earth', mother: 'Mem',  motherHeb: 'מ' },
          { name: 'Aquarius',    letter: 'Tzadi',  heb: 'צ', dates: 'Jan 20 – Feb 18', organ: 'Stomach',       sense: 'Contemplation', element: 'air',   mother: 'Alef', motherHeb: 'א' },
          { name: 'Pisces',      letter: 'Qof',    heb: 'ק', dates: 'Feb 19 – Mar 20', organ: 'Gizzard',       sense: 'Sleep',         element: 'water', mother: 'Mem',  motherHeb: 'מ' }
        ];
        // Index by Date.getDay(): 0 = Sunday ... 6 = Saturday (Sefer Yetzirah, Sunday first)
        var DAYS = [
          { weekday: 'Sunday',    letter: 'Bet',   heb: 'ב', planet: 'Saturn',  gate: 'Right eye',     holy: 'El',           holyHeb: 'אֵל' },
          { weekday: 'Monday',    letter: 'Gimel', heb: 'ג', planet: 'Jupiter', gate: 'Left eye',      holy: 'Elohim',       holyHeb: 'אֱלֹהִים' },
          { weekday: 'Tuesday',   letter: 'Dalet', heb: 'ד', planet: 'Mars',    gate: 'Right ear',     holy: 'YHWH',         holyHeb: 'יְהוָה' },
          { weekday: 'Wednesday', letter: 'Kaf',   heb: 'כ', planet: 'Sun',     gate: 'Left ear',      holy: 'YHWH Tzevaot', holyHeb: 'יְהוָה צְבָאוֹת' },
          { weekday: 'Thursday',  letter: 'Pe',    heb: 'פ', planet: 'Venus',   gate: 'Right nostril', holy: 'Elohim Tzevaot', holyHeb: 'אֱלֹהִים צְבָאוֹת' },
          { weekday: 'Friday',    letter: 'Resh',  heb: 'ר', planet: 'Mercury', gate: 'Left nostril',  holy: 'Shaddai',      holyHeb: 'שַׁדַּי' },
          { weekday: 'Saturday',  letter: 'Tav',   heb: 'ת', planet: 'Moon',    gate: 'Mouth',         holy: 'Adonai',       holyHeb: 'אֲדֹנָי' }
        ];
        var RULERS = { Aries: 'Mars', Taurus: 'Venus', Gemini: 'Mercury', Cancer: 'Moon', Leo: 'Sun', Virgo: 'Mercury', Libra: 'Venus', Scorpio: 'Mars', Sagittarius: 'Jupiter', Capricorn: 'Saturn', Aquarius: 'Saturn', Pisces: 'Jupiter' };
        var RULED_SIGNS = { Sun: ['Leo'], Moon: ['Cancer'], Mercury: ['Gemini', 'Virgo'], Venus: ['Taurus', 'Libra'], Mars: ['Aries', 'Scorpio'], Jupiter: ['Sagittarius', 'Pisces'], Saturn: ['Capricorn', 'Aquarius'] };
        var CUSPS = [
          [1, 20, 10], [2, 19, 11], [3, 21, 0], [4, 20, 1], [5, 21, 2], [6, 21, 3],
          [7, 23, 4], [8, 23, 5], [9, 23, 6], [10, 23, 7], [11, 22, 8], [12, 22, 9]
        ];
        function sunSignIndex(date) {
          var m = date.getMonth() + 1, d = date.getDate(), idx = 9; // Capricorn before Jan 20
          for (var i = 0; i < CUSPS.length; i++) {
            if (m > CUSPS[i][0] || (m === CUSPS[i][0] && d >= CUSPS[i][1])) idx = CUSPS[i][2];
          }
          return idx;
        }
        function moonLon(now) {
          var d = now.getTime() / 86400000 - 10957.5; // days since J2000.0
          var rad = Math.PI / 180;
          var L = 218.3165 + 13.17639648 * d;
          var M = 134.9634 + 13.06499295 * d;
          var F = 93.2721 + 13.22935024 * d;
          var D = 297.8502 + 12.19074912 * d;
          var Ms = 357.5291 + 0.98560028 * d;
          var lon = L
            + 6.2888 * Math.sin(M * rad)
            + 1.2740 * Math.sin((2 * D - M) * rad)
            + 0.6580 * Math.sin(2 * D * rad)
            + 0.2136 * Math.sin(2 * M * rad)
            - 0.1855 * Math.sin(Ms * rad)
            - 0.1143 * Math.sin(2 * F * rad);
          return ((lon % 360) + 360) % 360;
        }

        /* ---- Ephemeris: low-precision planetary positions (Schlyter) ---- */
        var ORBIT = {
          Mercury: { a: [0.38709927, 0.00000037], e: [0.20563593, 0.00001906], i: [-7.00497902, -0.00594749], L: [252.25032350, 149472.67411175], lp: [77.45779628, 0.16047689], om: [48.33076593, -0.12534081] },
          Venus:   { a: [0.72333566, 0.00000390], e: [0.00677672, -0.00004107], i: [3.39467605, -0.00078890], L: [181.97909950, 58517.81538729], lp: [131.60246718, 0.00268329], om: [76.67984255, -0.27769418] },
          Earth:   { a: [1.00000261, 0.00000562], e: [0.01671123, -0.00004392], i: [-0.00001531, -0.01294668], L: [100.46457166, 35999.37244981], lp: [102.93768193, 0.32327364], om: [0.0, 0.0] },
          Mars:    { a: [1.52371034, 0.00001847], e: [0.09339410, 0.00007882], i: [1.84969142, -0.00813131], L: [-4.55343205, 19140.30268499], lp: [-23.94362959, 0.44441088], om: [49.55953891, -0.29257343] },
          Jupiter: { a: [5.20288700, -0.00011607], e: [0.04838624, -0.00013253], i: [1.30439695, -0.00183714], L: [34.39644051, 3034.74612775], lp: [14.72847983, 0.21252668], om: [100.47390909, 0.20469106] },
          Saturn:  { a: [9.53667594, -0.00125060], e: [0.05386179, -0.00050991], i: [2.48599187, 0.00193609], L: [49.95424423, 1222.49362201], lp: [92.59887831, -0.41897216], om: [113.66242448, -0.28867794] }
        };
        var RAD = Math.PI / 180, DEG = 180 / Math.PI;
        function norm360(x) { return ((x % 360) + 360) % 360; }
        function helio(el, T) {
          var a = el.a[0] + el.a[1] * T, e = el.e[0] + el.e[1] * T, i = (el.i[0] + el.i[1] * T) * RAD;
          var L = norm360(el.L[0] + el.L[1] * T), lp = norm360(el.lp[0] + el.lp[1] * T), om = norm360(el.om[0] + el.om[1] * T);
          var w = (lp - om) * RAD, M = norm360(L - lp), Mr = M * RAD;
          var E = M + DEG * e * Math.sin(Mr) * (1 + e * Math.cos(Mr));
          for (var k = 0; k < 10; k++) {
            var Er = E * RAD;
            E = E - (E - DEG * e * Math.sin(Er) - M) / (1 - e * Math.cos(Er));
          }
          var Er2 = E * RAD;
          var xv = a * (Math.cos(Er2) - e), yv = a * Math.sqrt(1 - e * e) * Math.sin(Er2);
          var cw = Math.cos(w), sw = Math.sin(w), co = Math.cos(om * RAD), so = Math.sin(om * RAD), ci = Math.cos(i), si = Math.sin(i);
          var xh = (cw * co - sw * so * ci) * xv + (-sw * co - cw * so * ci) * yv;
          var yh = (cw * so + sw * co * ci) * xv + (-sw * so + cw * co * ci) * yv;
          var zh = (sw * si) * xv + (cw * si) * yv;
          return { x: xh, y: yh, z: zh, lon: norm360(Math.atan2(yh, xh) * DEG) };
        }
        function geoLon(planet, T, earth) {
          var h = helio(ORBIT[planet], T);
          return norm360(Math.atan2(h.y - earth.y, h.x - earth.x) * DEG);
        }
        function dayNumber(y, m, d, ut) {
          return 367 * y - Math.floor(7 * (y + Math.floor((m + 9) / 12)) / 4) + Math.floor(275 * m / 9) + d - 730530 + ut / 24;
        }

        /* ---- Work out today ---- */
        function set(id, text) { var el = document.getElementById(id); if (el) el.textContent = text; }
        var now = new Date();
        var d = dayNumber(now.getUTCFullYear(), now.getUTCMonth() + 1, now.getUTCDate(), now.getUTCHours() + now.getUTCMinutes() / 60);
        var T = d / 36525;
        var earth = helio(ORBIT.Earth, T);
        var sunLon = norm360(earth.lon + 180);
        var moonLonVal = moonLon(now);
        var day = DAYS[now.getDay()];
        var sun = SIGNS[sunSignIndex(now)];
        var moon = SIGNS[Math.floor(moonLonVal / 30) % 12];

        set('today-date', now.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' — the day letter, the sun letter, the moon letter, and the holy name of the day.');
        set('today-day-heb', day.heb);
        set('today-day-name', day.letter);
        set('today-day-sub', day.weekday + ' — ' + day.planet);
        set('today-sun-heb', sun.heb);
        set('today-sun-name', sun.letter);
        set('today-sun-sub', 'Sun in ' + sun.name);
        set('today-moon-heb', moon.heb);
        set('today-moon-name', moon.letter);
        set('today-moon-sub', 'Moon in ' + moon.name);
        set('today-holy-heb', day.holyHeb);
        set('today-holy-name', day.holy);
        set('today-holy-sub', day.weekday);

        /* ---- The seven planets as they stand ---- */
        function planetEntry(planet, lon) {
          var dbl = null;
          for (var i = 0; i < DAYS.length; i++) if (DAYS[i].planet === planet) dbl = DAYS[i];
          var signIdx = Math.floor(lon / 30) % 12;
          return { planet: planet, dbl: dbl, sign: SIGNS[signIdx], deg: lon % 30 };
        }
        var planets = [
          planetEntry('Saturn', geoLon('Saturn', T, earth)),
          planetEntry('Jupiter', geoLon('Jupiter', T, earth)),
          planetEntry('Mars', geoLon('Mars', T, earth)),
          planetEntry('Sun', sunLon),
          planetEntry('Venus', geoLon('Venus', T, earth)),
          planetEntry('Mercury', geoLon('Mercury', T, earth)),
          planetEntry('Moon', moonLonVal)
        ];

        /* ---- Today's letters: the day's double, and the simple of the sign the day's planet stands in.
           The pointed names and the verses are the prayer section's own — Genesis 1, act by act. ---- */
        var POINTED = { Alef: 'אָלֶף', Bet: 'בֵּית', Gimel: 'גִּימֶל', Dalet: 'דָּלֶת', He: 'הֵא', Vav: 'וָו', Zayin: 'זַיִן', Chet: 'חֵית', Tet: 'טֵית', Yod: 'יוּד', Kaf: 'כַּף', Lamed: 'לָמֶד', Mem: 'מֵם', Nun: 'נוּן', Samekh: 'סָמֶךְ', Ayin: 'עַיִן', Pe: 'פֵּא', Tzadi: 'צַדִּי', Qof: 'קוּף', Resh: 'רֵישׁ', Shin: 'שִׁין', Tav: 'תָּו' };
        var VERSES = {
          Alef: 'God made the firmament', Bet: 'God saw the light that it was good', Gimel: 'God saw that it was good', Dalet: 'God saw that it was good',
          He: 'The spirit of God hovered', Vav: 'God divided between the light and darkness', Zayin: 'God called the light day', Chet: 'God called the firmament heaven',
          Tet: 'God called the dry land earth', Yod: 'God placed them in the firmament', Kaf: 'God saw that it was good', Lamed: 'God created great whales',
          Mem: 'God made two luminaries', Nun: 'God blessed them, be fruitful and multiply', Samekh: 'God created man', Ayin: 'In the form of God He created him',
          Pe: 'God saw that it was good', Tzadi: 'God blessed them', Qof: 'God said, behold I have given you', Resh: 'God saw that it was good',
          Shin: 'God made the beasts of the field', Tav: 'God saw all that He had made'
        };
        function letterCard(label, letterName, heb, verse) {
          return '<article class="letter-verse-card card">'
            + '<span class="lv-label">' + label + '</span>'
            + '<span class="heb heb-big">' + heb + '</span>'
            + '<span class="lv-name">' + POINTED[letterName] + '</span>'
            + '<span class="lv-english">' + letterName + '</span>'
            + '<div class="lv-div"></div>'
            + '<span class="lv-verse">' + verse + '</span>'
            + '<span class="lv-src">From the prayer — Genesis 1</span>'
            + '</article>';
        }
        var dayPlanetEntry = null;
        for (var k = 0; k < planets.length; k++) if (planets[k].planet === day.planet) dayPlanetEntry = planets[k];
        var daySign = dayPlanetEntry.sign;
        set('todays-letters-intro', day.letter + ', ' + day.weekday + '\u2019s letter, and ' + daySign.letter + ', the letter of ' + daySign.name + ', where ' + day.planet + ' stands today.');
        document.getElementById('todays-letters').innerHTML =
          letterCard('Day letter — ' + day.weekday, day.letter, day.heb, VERSES[day.letter])
          + letterCard(day.planet + ' in ' + daySign.name, daySign.letter, daySign.heb, VERSES[daySign.letter]);

        /* ---- This month's strongest day ---- */
        var sunSign = SIGNS[Math.floor(sunLon / 30) % 12];
        var sunRuler = RULERS[sunSign.name];
        var rulerDay = null;
        for (var i = 0; i < DAYS.length; i++) if (DAYS[i].planet === sunRuler) rulerDay = DAYS[i];
        var sunDbl = null;
        for (var j = 0; j < DAYS.length; j++) if (DAYS[j].planet === 'Sun') sunDbl = DAYS[j];
        set('strongest-chain', rulerDay.weekday + ' - Sun - ' + sunDbl.letter + ' - ' + sunSign.name + ' - ' + sunSign.letter);
        set('strongest-note', rulerDay.weekday + ' is the month\u2019s strongest day. The Sun is in ' + sunSign.name + ', ' + sunRuler + '\u2019s sign, so ' + sunRuler + '\u2019s day rules this month. The Sun\u2019s own day, for meditating ' + sunDbl.letter + ' + ' + sunSign.letter + ', is ' + sunDbl.weekday + '.');

        /* ---- Build the transit chart as cards, in the order of the week — Sunday first ---- */
        function fact(label, valueHtml) {
          return '<div class="fact"><span class="fact-label">' + label + '</span><span class="fact-value">' + valueHtml + '</span></div>';
        }
        var html = '<div class="cards">';
        planets.forEach(function (p) {
          var motherKey = p.sign.mother.toLowerCase();
          var atHome = RULED_SIGNS[p.planet].indexOf(p.sign.name) !== -1;
          var cusp = (p.deg < 1 || p.deg > 29) ? ' <span class="cusp-note">near the cusp</span>' : '';
          html += '<article class="planet-card card mother-' + motherKey + '" data-mother="' + motherKey + '">';
          html += '<div class="card-head"><span class="planet-name">' + p.planet + '</span>'
            + (atHome ? '<span class="athome">At home — doubled</span>' : '')
            + '</div>';
          html += '<div class="double-row"><span class="heb heb-big">' + p.dbl.heb + '</span><div class="dbl-meta">'
            + '<span class="dbl-line">Planet letter — ' + p.dbl.letter + ', the double</span>'
            + '<span class="dbl-line soft">Gate — ' + p.dbl.gate + '</span>'
            + '<span class="dbl-line">Meditate ' + p.dbl.weekday + '</span>'
            + '</div></div>';
          html += '<div class="card-div"></div>';
          html += '<div class="sign-row"><span class="sign-name">' + p.sign.name + ' ' + p.deg.toFixed(0) + '°</span>'
            + '<span class="sign-dates">' + p.sign.dates + '</span>' + cusp + '</div>';
          html += '<div class="facts">'
            + fact('Sign letter', p.sign.letter + ' <span class="heb heb-md">' + p.sign.heb + '</span>')
            + fact('Body part', p.sign.organ)
            + fact('Sense', p.sign.sense)
            + fact('Element', '<span class="elem elem-' + p.sign.element + '">' + p.sign.element[0].toUpperCase() + p.sign.element.slice(1) + '</span>')
            + fact('Mother', p.sign.mother + ' <span class="heb heb-md">' + p.sign.motherHeb + '</span>')
            + '</div>';
          if (p.planet === 'Saturn' && p.sign.name === 'Aries') {
            html += '<div class="reading">Reading — my own experience, not the teaching: speech is deciding life and death in this transit.</div>';
          }
          html += '</article>';
        });
        html += '<div class="planet-card card empty-card" id="chart-empty" hidden></div>';
        html += '</div>';
        document.getElementById('chart').innerHTML = html;

        /* ---- Mother filter ---- */
        var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
        function apply(filter) {
          var cards = Array.prototype.slice.call(document.querySelectorAll('#chart .planet-card'));
          var visible = 0;
          cards.forEach(function (c) {
            if (c.id === 'chart-empty') return;
            var show = filter === 'all' || c.dataset.mother === filter;
            c.classList.toggle('hidden', !show);
            if (show) visible++;
          });
          var empty = document.getElementById('chart-empty');
          if (empty) {
            empty.hidden = visible !== 0;
            if (visible === 0) empty.textContent = 'No planet under ' + filter.charAt(0).toUpperCase() + filter.slice(1) + ' today.';
          }
        }
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
            chip.setAttribute('aria-pressed', 'true');
            apply(chip.dataset.filter);
          });
        });
      })();
    </script>
    <script>
      (function () {
        var header = document.getElementById('site-header');
        var toggle = document.getElementById('nav-toggle');
        if (!header || !toggle) return;
        toggle.addEventListener('click', function () {
          var open = header.classList.toggle('nav-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      })();
    </script>
  </body>
</html>

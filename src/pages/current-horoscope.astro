<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>Current Horoscope</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=IM+Fell+English:ital@0;1&family=Frank+Ruhl+Libre:wght@400;500&family=Redaction+10&display=swap" rel="stylesheet" />
    <style is:global>
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2.25rem; }
      * { box-sizing: border-box; }
      :root {
        color-scheme: light dark;
        /* Type scale — Major Third (1.25), base 1.35rem. Five sizes only, used everywhere. */
        --text-xs: 0.86rem;
        --text-sm: 1.08rem;
        --text-base: 1.35rem;
        --text-lg: 1.69rem;
        --text-xl: 2.11rem;
        --text-2xl: 2.64rem;
        /* Spacing — 8-point scale. Every gap on the page is one of these. */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 16px;
        --space-4: 24px;
        --space-5: 32px;
        --space-6: 48px;
        --space-7: 64px;
        /* Radius — cards 16px, chips pill. */
        --radius-card: 16px;
        --bg: #f7f5f0;
        --surface: #ffffff;
        --surface-2: #efede6;
        --ink: #1c1e26;
        --ink-soft: #4a4d59;
        --line: #d8d4c8;
        --accent: #191970;
        --accent-soft: #e3e4f2;
        --heb: #191970;
        --fire: #b34a1f; --fire-bg: #fbe9df;
        --earth: #6d5a2e; --earth-bg: #f1ead3;
        --air: #3e6b7a; --air-bg: #e0eef2;
        --water: #2c4f9e; --water-bg: #e0e8fa;
        /* Header — same flat bar as the rest of the site. */
        --header-bg: #005b96;
        --header-ink: #ffffff;
        --header-btn-bg: rgba(255, 255, 255, 0.12);
        --header-btn-border: rgba(255, 255, 255, 0.35);
        --header-active-bg: #ffffff;
        --header-active-ink: #005b96;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #172022;
          --surface: #1f2c2e;
          --surface-2: #243335;
          --ink: #ece9df;
          --ink-soft: #b9beb9;
          --line: #3a4a4c;
          --accent: #83adb5;
          --accent-soft: #26383b;
          --heb: #e8c766;
          --fire: #eda27c; --fire-bg: #3a2a22;
          --earth: #d9c48a; --earth-bg: #37321f;
          --air: #9fd3e0; --air-bg: #22383d;
          --water: #a9c2f5; --water-bg: #232f47;
          /* Header — same flat bar as the rest of the site. */
          --header-bg: #6fcb9f;
          --header-ink: #101410;
          --header-btn-bg: rgba(0, 0, 0, 0.1);
          --header-btn-border: rgba(0, 0, 0, 0.25);
          --header-active-bg: #101410;
          --header-active-ink: #6fcb9f;
        }
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "IM Fell English", Georgia, serif;
        font-size: var(--text-base);
        line-height: 1.6;
      }
      .wrap { max-width: 1060px; margin: 0 auto; padding: var(--space-7) var(--space-6) var(--space-7); }
      h1, h2, h3, .oswald { font-family: "Oswald", "Arial Narrow", sans-serif; }
      h1 { font-size: var(--text-2xl); font-weight: 600; letter-spacing: .01em; line-height: 1.15; margin: 0 0 var(--space-2); }
      h2 { font-size: var(--text-xl); font-weight: 600; line-height: 1.2; margin: var(--space-6) 0 var(--space-3); }
      h3 { font-size: var(--text-lg); font-weight: 600; line-height: 1.2; margin: 0; }
      p { margin: 0 0 var(--space-3); max-width: 44rem; }
      .lede { color: var(--ink-soft); font-size: var(--text-lg); line-height: 1.55; }
      .heb { font-family: "Frank Ruhl Libre", serif; color: var(--heb); font-weight: 500; }
      .heb-big { font-size: var(--text-2xl); line-height: 1; }
      .heb-md { font-size: var(--text-lg); line-height: 1; }

      /* Site header — the same bar as the rest of the site: wordmark left,
         nav buttons right, burger on a narrow screen. */
      #site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        padding: 0.5rem 1.5rem;
        background: var(--header-bg);
        border-bottom: 1px solid rgba(0, 0, 0, 0.15);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        color: var(--header-ink);
      }
      #site-header .site-name { justify-self: start; text-decoration: none; }
      #site-header .site-wordmark { font-family: "Redaction 10", "IM Fell English", serif; font-size: var(--text-sm); letter-spacing: 0.08em; color: var(--header-ink); }
      #site-header nav { display: flex; gap: 0.6rem; justify-self: end; }
      #site-header nav a {
        font-family: "Oswald", sans-serif;
        font-size: var(--text-sm);
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.45rem 1.1rem;
        border: 1px solid var(--header-btn-border);
        border-radius: var(--radius-sm);
        background-color: var(--header-btn-bg);
        color: var(--header-ink);
        text-decoration: none;
        transition: transform 150ms cubic-bezier(0.32, 0.72, 0, 1), border-color 200ms cubic-bezier(0.32, 0.72, 0, 1), background-color 200ms cubic-bezier(0.32, 0.72, 0, 1);
      }
      #site-header nav a:hover { border-color: var(--header-ink); transform: translateY(-1px); }
      #site-header nav a.current {
        background-color: var(--header-active-bg);
        border-color: transparent;
        color: var(--header-active-ink);
      }
      #site-header nav a:active { transition-duration: 100ms; transform: scale(0.97); }
      #site-header nav a:focus-visible { outline: 2px solid var(--header-ink); outline-offset: 2px; }
      .nav-toggle {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--header-btn-border);
        border-radius: var(--radius-sm);
        background: var(--header-btn-bg);
        color: var(--header-ink);
        cursor: pointer;
        justify-self: end;
      }
      .nav-toggle span {
        display: block;
        width: 1.25rem;
        height: 2px;
        background: currentColor;
        border-radius: 1px;
      }
      @media (max-width: 640px) {
        #site-header { grid-template-columns: 1fr auto; row-gap: 0.5rem; padding: 0.6rem 1rem; }
        .nav-toggle { display: inline-flex; }
        #site-header nav { display: none; grid-column: 1 / -1; grid-row: 2; flex-direction: column; align-items: flex-end; gap: 0.4rem; justify-content: flex-start; }
        #site-header.nav-open nav { display: flex; }
        #site-header nav a { padding: 0.35rem 0.8rem; }
      }

      /* Shared card surface — one treatment for every card on the page */
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-card);
        padding: var(--space-4);
      }

      /* Today */
      .today-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-2); }
      .day { text-align: center; }
      .day .dname { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); display: block; }
      .day .pname { display: block; font-size: var(--text-base); margin-top: var(--space-2); }
      .day .gate { display: block; font-size: var(--text-base); color: var(--ink-soft); margin-top: var(--space-1); }
      .day .heb-big { display: block; margin-top: var(--space-2); }
      @media (max-width: 640px) { .today-grid { grid-template-columns: repeat(2, 1fr); } }

      /* Strongest day panel */
      .strongest { margin: var(--space-3) 0 var(--space-2); }
      .strongest .chain { font-family: "Oswald", sans-serif; font-size: var(--text-lg); font-weight: 600; letter-spacing: .02em; margin: 0 0 var(--space-2); }
      .strongest p { margin-bottom: var(--space-2); }
      .strongest p:last-child { margin-bottom: 0; }

      /* Today's letters — the day's two letters, in the main page's card scheme */
      .today-letters-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-2); align-items: stretch; }
      .letter-verse-card { display: flex; flex-direction: column; gap: var(--space-2); }
      .lv-label { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
      .lv-name { font-family: "Frank Ruhl Libre", serif; color: var(--heb); font-size: var(--text-lg); font-weight: 500; }
      .lv-english { font-size: var(--text-base); }
      .lv-div { height: 1px; background: var(--line); }
      .lv-verse { font-size: var(--text-base); font-style: italic; }
      .lv-src { font-size: var(--text-sm); color: var(--ink-soft); }
      @media (max-width: 680px) { .today-letters-grid { grid-template-columns: 1fr; } }

      /* Three mothers */
      .mothers { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-2); }
      @media (max-width: 640px) { .mothers { grid-template-columns: 1fr; } }

      /* Filters */
      .filters { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0 var(--space-3); align-items: center; }
      .filters span { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); margin-right: var(--space-1); }
      .chip {
        font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .03em;
        padding: var(--space-2) var(--space-3); border-radius: 999px; cursor: pointer;
        border: 1px solid var(--line); background: var(--surface); color: var(--ink);
        min-height: 2.5rem;
      }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
      @media (prefers-color-scheme: dark) { .chip[aria-pressed="true"] { color: #172022; } }

      /* Planet card grid */
      .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); align-items: stretch; }
      .planet-card.hidden { display: none; }
      .empty-card { color: var(--ink-soft); }
      .planet-card {
        display: flex; flex-direction: column; gap: var(--space-3);
        border-top: 4px solid var(--elem-color, var(--line));
      }
      .planet-card.mother-alef { --elem-color: var(--air); }
      .planet-card.mother-mem { --elem-color: var(--water); }
      .planet-card.mother-shin { --elem-color: var(--fire); }
      .card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; }
      .planet-name { font-family: "Oswald", sans-serif; font-size: var(--text-lg); font-weight: 600; letter-spacing: .02em; }
      .athome {
        font-family: "Oswald", sans-serif; font-size: var(--text-xs); letter-spacing: .07em; text-transform: uppercase;
        padding: var(--space-1) 0.75rem; border-radius: 999px; white-space: nowrap;
        background: var(--accent); color: #fff;
      }
      @media (prefers-color-scheme: dark) { .athome { color: #172022; } }
      .double-row { display: flex; align-items: center; gap: var(--space-3); }
      .dbl-meta { display: flex; flex-direction: column; gap: var(--space-1); }
      .dbl-line { font-size: var(--text-base); }
      .dbl-line.soft { color: var(--ink-soft); font-size: var(--text-sm); }
      .card-div { height: 1px; background: var(--line); }
      .sign-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
      .sign-name { font-size: var(--text-lg); font-weight: 600; }
      .sign-dates { color: var(--ink-soft); font-size: var(--text-sm); }
      .cusp-note { color: var(--ink-soft); font-size: var(--text-sm); font-style: italic; }
      .facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
      .fact { display: flex; flex-direction: column; gap: var(--space-1); }
      .fact-label { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
      .fact-value { font-size: var(--text-base); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
      .reading { border-top: 1px solid var(--line); padding-top: var(--space-2); color: var(--ink-soft); font-style: italic; font-size: var(--text-base); }
      .empty-card { color: var(--ink-soft); font-style: italic; border-top-color: var(--line); }

      /* Element pills */
      .elem {
        display: inline-block; font-family: "Oswald", sans-serif; font-size: var(--text-xs); letter-spacing: .07em; text-transform: uppercase;
        padding: var(--space-1) 0.75rem; border-radius: 999px; white-space: nowrap;
      }
      .elem-fire { background: var(--fire-bg); color: var(--fire); }
      .elem-earth { background: var(--earth-bg); color: var(--earth); }
      .elem-air { background: var(--air-bg); color: var(--air); }
      .elem-water { background: var(--water-bg); color: var(--water); }

      .note { color: var(--ink-soft); font-size: var(--text-sm); }
      .src { border-top: 1px solid var(--line); margin-top: var(--space-6); padding-top: var(--space-4); color: var(--ink-soft); font-size: var(--text-sm); }
      .src p { margin-bottom: var(--space-2); }

      /* Mobile: single column, tighter card padding, same scale */
      @media (max-width: 680px) {
        .wrap { padding: var(--space-5) var(--space-4) var(--space-6); }
        .cards { grid-template-columns: 1fr; gap: var(--space-3); }
        .card { padding: 20px; }
      }
    </style>
  </head>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>Kabbalistic Pokedox</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=IM+Fell+English:ital@0;1&family=Frank+Ruhl+Libre:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2.25rem; }
      * { box-sizing: border-box; }
      :root {
        color-scheme: light dark;
        /* Type scale — Major Third (1.25), base 1.35rem. Five sizes only, used everywhere. */
        --text-xs: 0.86rem;
        --text-sm: 1.08rem;
        --text-base: 1.35rem;
        --text-lg: 1.69rem;
        --text-xl: 2.11rem;
        --text-2xl: 2.64rem;
        /* Spacing — 8-point scale. Every gap on the page is one of these. */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 16px;
        --space-4: 24px;
        --space-5: 32px;
        --space-6: 48px;
        --space-7: 64px;
        /* Radius — cards 16px, chips pill. */
        --radius-card: 16px;
        --bg: #f7f5f0;
        --surface: #ffffff;
        --surface-2: #efede6;
        --ink: #1c1e26;
        --ink-soft: #4a4d59;
        --line: #d8d4c8;
        --accent: #191970;
        --accent-soft: #e3e4f2;
        --heb: #191970;
        --fire: #b34a1f; --fire-bg: #fbe9df;
        --earth: #6d5a2e; --earth-bg: #f1ead3;
        --air: #3e6b7a; --air-bg: #e0eef2;
        --water: #2c4f9e; --water-bg: #e0e8fa;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #172022;
          --surface: #1f2c2e;
          --surface-2: #243335;
          --ink: #ece9df;
          --ink-soft: #b9beb9;
          --line: #3a4a4c;
          --accent: #83adb5;
          --accent-soft: #26383b;
          --heb: #e8c766;
          --fire: #eda27c; --fire-bg: #3a2a22;
          --earth: #d9c48a; --earth-bg: #37321f;
          --air: #9fd3e0; --air-bg: #22383d;
          --water: #a9c2f5; --water-bg: #232f47;
        }
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "IM Fell English", Georgia, serif;
        font-size: var(--text-base);
        line-height: 1.6;
      }
      .wrap { max-width: 1060px; margin: 0 auto; padding: var(--space-7) var(--space-6) var(--space-7); }
      h1, h2, h3, .oswald { font-family: "Oswald", "Arial Narrow", sans-serif; }
      h1 { font-size: var(--text-2xl); font-weight: 600; letter-spacing: .01em; line-height: 1.2; margin: 0 0 var(--space-2); }
      h2 { font-size: var(--text-xl); font-weight: 600; margin: var(--space-6) 0 var(--space-3); }
      p { margin: 0 0 var(--space-3); max-width: 44rem; }
      .lede { color: var(--ink-soft); font-size: var(--text-lg); }
      .heb { font-family: "Frank Ruhl Libre", serif; color: var(--heb); font-weight: 500; }
      .heb-big { font-size: var(--text-2xl); line-height: 1; }
      .heb-md { font-size: var(--text-lg); line-height: 1; }
      .backlink { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .03em; color: var(--accent); text-decoration: none; display: inline-block; margin-bottom: var(--space-3); }

      /* Week strip */
      .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-2); margin: var(--space-3) 0 var(--space-2); }
      .day {
        background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
        padding: var(--space-4); text-align: center;
      }
      .day .dname { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); display: block; }
      .day .pname { display: block; font-size: var(--text-base); margin-top: var(--space-1); }
      .day .gate { display: block; font-size: var(--text-sm); color: var(--ink-soft); margin-top: var(--space-1); }
      .day .heb-big { display: block; margin-top: var(--space-2); }
      @media (max-width: 640px) { .week { grid-template-columns: repeat(4, 1fr); } }

      /* Today */
      .today-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-2); }
      @media (max-width: 640px) { .today-grid { grid-template-columns: repeat(2, 1fr); } }

      /* Three mothers */
      .mothers { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-2); }
      @media (max-width: 640px) { .mothers { grid-template-columns: 1fr; } }

      /* Filters */
      .filters { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0 var(--space-3); align-items: center; }
      .filters span { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); margin-right: var(--space-1); }
      .chip {
        font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .03em;
        padding: var(--space-2) var(--space-3); border-radius: 999px; cursor: pointer;
        border: 1px solid var(--line); background: var(--surface); color: var(--ink);
        min-height: 2.5rem;
      }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
      @media (prefers-color-scheme: dark) { .chip[aria-pressed="true"] { color: #172022; } }

      /* Table */
      .table-scroll { border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden; background: var(--surface); }
      table { width: 100%; border-collapse: collapse; }
      thead th {
        font-family: "Oswald", sans-serif; font-weight: 500; font-size: var(--text-sm); letter-spacing: .09em; text-transform: uppercase;
        text-align: left; color: var(--ink-soft); background: var(--surface-2);
        padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line);
      }
      tr.planet-row td {
        background: var(--accent-soft); padding: var(--space-3); border-top: 2px solid var(--line);
      }
      tr.planet-row:first-child td { border-top: none; }
      .planet-name { font-family: "Oswald", sans-serif; font-size: var(--text-lg); font-weight: 600; letter-spacing: .02em; }
      .planet-day { color: var(--ink-soft); font-size: var(--text-sm); }
      .planet-letter-cell { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
      .planet-letter-cell .lname { font-size: var(--text-base); }
      .planet-gate { color: var(--ink-soft); font-size: var(--text-sm); }
      tr.sign-row td { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--line); vertical-align: middle; }
      tr.sign-row td:first-child { padding-left: var(--space-5); }
      .sign-name { font-size: var(--text-base); }
      .sign-letter-cell { display: flex; align-items: center; gap: var(--space-2); }
      .elem {
        display: inline-block; font-family: "Oswald", sans-serif; font-size: var(--text-xs); letter-spacing: .07em; text-transform: uppercase;
        padding: var(--space-1) 0.75rem; border-radius: 999px; white-space: nowrap;
      }
      .elem-fire { background: var(--fire-bg); color: var(--fire); }
      .elem-earth { background: var(--earth-bg); color: var(--earth); }
      .elem-air { background: var(--air-bg); color: var(--air); }
      .elem-water { background: var(--water-bg); color: var(--water); }
      tr.hidden-row { display: none; }
      .dimmed { opacity: .35; }

      .note { color: var(--ink-soft); font-size: var(--text-sm); }
      .src { border-top: 1px solid var(--line); margin-top: var(--space-6); padding-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
      .src p { margin-bottom: var(--space-2); }

      /* Mobile: table becomes stacked blocks */
      @media (max-width: 680px) {
        table, thead, tbody, tr, td { display: block; width: 100%; }
        thead { display: none; }
        tr.planet-row td { border-top: 2px solid var(--line); }
        tr.sign-row { border-top: 1px solid var(--line); padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4); }
        tr.sign-row td { border-top: none; padding: var(--space-1) 0; }
        tr.sign-row td:first-child { padding-left: 0; }
        tr.sign-row td::before {
          content: attr(data-label); display: inline-block; min-width: 6.2rem;
          font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft);
        }
        tr.sign-row td.cell-sign::before { content: ""; min-width: 0; }
        .sign-name { font-size: var(--text-base); }
      }
    </style>
  </head>

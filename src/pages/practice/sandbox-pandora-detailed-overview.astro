    <script>
      (function () {
        var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
        var rows = Array.prototype.slice.call(document.querySelectorAll('#main-table tbody tr'));
        function apply(filter) {
          var currentPlanet = null, planetHasVisible = {};
          rows.forEach(function (r) {
            if (r.classList.contains('planet-row')) { currentPlanet = r; planetHasVisible[r.dataset.planet] = false; r._planet = r.dataset.planet; }
            else { r._planet = currentPlanet ? currentPlanet.dataset.planet : null; }
          });
          rows.forEach(function (r) {
            if (r.classList.contains('sign-row')) {
              var show = filter === 'all' || r.dataset.element === filter;
              r.classList.toggle('hidden-row', !show);
              if (show) planetHasVisible[r._planet] = true;
            }
          });
          rows.forEach(function (r) {
            if (r.classList.contains('planet-row')) {
              r.classList.toggle('dimmed', filter !== 'all' && !planetHasVisible[r.dataset.planet]);
            }
          });
        }
        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
            chip.setAttribute('aria-pressed', 'true');
            apply(chip.dataset.filter);
          });
        });
      })();
    </script>

    <script>
      (function () {
        var SIGNS = [
          { name: 'Aries',       letter: 'He',     heb: 'ה' },
          { name: 'Taurus',      letter: 'Vav',    heb: 'ו' },
          { name: 'Gemini',      letter: 'Zayin',  heb: 'ז' },
          { name: 'Cancer',      letter: 'Chet',   heb: 'ח' },
          { name: 'Leo',         letter: 'Tet',    heb: 'ט' },
          { name: 'Virgo',       letter: 'Yod',    heb: 'י' },
          { name: 'Libra',       letter: 'Lamed',  heb: 'ל' },
          { name: 'Scorpio',     letter: 'Nun',    heb: 'נ' },
          { name: 'Sagittarius', letter: 'Samekh', heb: 'ס' },
          { name: 'Capricorn',   letter: 'Ayin',   heb: 'ע' },
          { name: 'Aquarius',    letter: 'Tzadi',  heb: 'צ' },
          { name: 'Pisces',      letter: 'Qof',    heb: 'ק' }
        ];
        // Index by Date.getDay(): 0 = Sunday ... 6 = Saturday (Sefer Yetzirah, Sunday first)
        var DAYS = [
          { weekday: 'Sunday',    letter: 'Bet',   heb: 'ב', planet: 'Saturn',  holy: 'El',              holyHeb: 'אֵל' },
          { weekday: 'Monday',    letter: 'Gimel', heb: 'ג', planet: 'Jupiter', holy: 'Elohim',          holyHeb: 'אֱלֹהִים' },
          { weekday: 'Tuesday',   letter: 'Dalet', heb: 'ד', planet: 'Mars',    holy: 'YHWH',            holyHeb: 'יְהוָה' },
          { weekday: 'Wednesday', letter: 'Kaf',   heb: 'כ', planet: 'Sun',     holy: 'YHWH Tzevaot',    holyHeb: 'יְהוָה צְבָאוֹת' },
          { weekday: 'Thursday',  letter: 'Pe',    heb: 'פ', planet: 'Venus',   holy: 'Elohim Tzevaot',  holyHeb: 'אֱלֹהִים צְבָאוֹת' },
          { weekday: 'Friday',    letter: 'Resh',  heb: 'ר', planet: 'Mercury', holy: 'Shaddai',         holyHeb: 'שַׁדַּי' },
          { weekday: 'Saturday',  letter: 'Tav',   heb: 'ת', planet: 'Moon',    holy: 'Adonai',          holyHeb: 'אֲדֹנָי' }
        ];
        // Sign start dates [month, day, sign index into SIGNS], in calendar order
        var CUSPS = [
          [1, 20, 10], [2, 19, 11], [3, 21, 0], [4, 20, 1], [5, 21, 2], [6, 21, 3],
          [7, 23, 4], [8, 23, 5], [9, 23, 6], [10, 23, 7], [11, 22, 8], [12, 22, 9]
        ];
        function sunSignIndex(date) {
          var m = date.getMonth() + 1, d = date.getDate(), idx = 9; // Capricorn before Jan 20
          for (var i = 0; i < CUSPS.length; i++) {
            if (m > CUSPS[i][0] || (m === CUSPS[i][0] && d >= CUSPS[i][1])) idx = CUSPS[i][2];
          }
          return idx;
        }
        function moonSignIndex(now) {
          var d = now.getTime() / 86400000 - 10957.5; // days since J2000.0
          var rad = Math.PI / 180;
          var L = 218.3165 + 13.17639648 * d;  // mean longitude
          var M = 134.9634 + 13.06499295 * d;  // mean anomaly
          var F = 93.2721 + 13.22935024 * d;   // mean distance from ascending node
          var D = 297.8502 + 12.19074912 * d;  // mean elongation
          var Ms = 357.5291 + 0.98560028 * d;  // sun's mean anomaly
          var lon = L
            + 6.2888 * Math.sin(M * rad)
            + 1.2740 * Math.sin((2 * D - M) * rad)
            + 0.6580 * Math.sin(2 * D * rad)
            + 0.2136 * Math.sin(2 * M * rad)
            - 0.1855 * Math.sin(Ms * rad)
            - 0.1143 * Math.sin(2 * F * rad);
          lon = ((lon % 360) + 360) % 360;
          return Math.floor(lon / 30) % 12;
        }
        function set(id, text) { var el = document.getElementById(id); if (el) el.textContent = text; }
        var now = new Date();
        var day = DAYS[now.getDay()];
        var sun = SIGNS[sunSignIndex(now)];
        var moon = SIGNS[moonSignIndex(now)];
        set('today-date', now.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' — the day letter, the sun letter, the moon letter, and the holy name of the day.');
        set('today-day-heb', day.heb);
        set('today-day-name', day.letter);
        set('today-day-sub', day.weekday + ' — ' + day.planet);
        set('today-sun-heb', sun.heb);
        set('today-sun-name', sun.letter);
        set('today-sun-sub', 'Sun in ' + sun.name);
        set('today-moon-heb', moon.heb);
        set('today-moon-name', moon.letter);
        set('today-moon-sub', 'Moon in ' + moon.name);
        set('today-holy-heb', day.holyHeb);
        set('today-holy-name', day.holy);
        set('today-holy-sub', day.weekday);
      })();
    </script>

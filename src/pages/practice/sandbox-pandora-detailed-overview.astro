          var currentPlanet = null, planetHasVisible = {};
          rows.forEach(function (r) {
            if (r.classList.contains('planet-row')) { currentPlanet = r; planetHasVisible[r.dataset.planet] = false; r._planet = r.dataset.planet; }
            else { r._planet = currentPlanet ? currentPlanet.dataset.planet : null; }
          });
          rows.forEach(function (r) {

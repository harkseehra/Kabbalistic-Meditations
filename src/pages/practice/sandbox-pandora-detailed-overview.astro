---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LETTERS, DOUBLES, sunLetter, moonLetter, holyNameOfDay, sunRange, nextMoonIngress } from '../../lib/transits.js';
import { SIGN_ICONS } from '../../lib/icons-signs.js';
import { ORGAN_ICONS } from '../../lib/icons-organs.js';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const rangeOf = (l) => `${MONTHS[l.start[0] - 1]} ${l.start[1]} – ${MONTHS[l.end[0] - 1]} ${l.end[1]}`;
const MOTHER_GLYPH = { Alef: 'א', Mem: 'מ', Shin: 'ש' };
---

<BaseLayout title="Sandbox Pandora Detailed Overview">
  <h1>Sandbox Pandora Detailed Overview</h1>

  <p>
    The whole system on one page. Each planet carries its double letter and its day.
    Under it, the signs it rules — each with its simple letter, its dates, its organ,
    its sense, its element, and the mother letter it belongs to.
  </p>
  <p class="dim small">
    The correspondences come from Sefer Yetzirah — chapter 3 for the mothers, chapter 4
    for the doubles, chapter 5 for the simples — as printed in the Warsaw 1884 edition
    on Sefaria (Sefaria Community Translation). The signs a planet rules are the
    traditional rulerships; the elements are the classical four.
  </p>

  <h2>Today</h2>
  <p class="dim" id="today-line">Loading today's values…</p>
  <noscript><p>Today's values need JavaScript — the sun and moon positions are computed in your browser, live.</p></noscript>

  <div class="transit-grid">
    <section class="letter-card" id="today-day-card">
      <p class="label">Day letter</p>
      <p class="glyph" id="today-day-glyph">–</p>
      <p class="name"><span id="today-day-name">…</span> <span class="pointed" id="today-day-pointed"></span></p>
      <p class="meta" id="today-day-meta"></p>
    </section>

    <section class="letter-card" id="today-sun-card">
      <p class="label">Sun letter</p>
      <p class="glyph" id="today-sun-glyph">–</p>
      <p class="name"><span id="today-sun-name">…</span> <span class="pointed" id="today-sun-pointed"></span></p>
      <p class="meta" id="today-sun-meta"></p>
      <p id="today-sun-note"></p>
    </section>

    <section class="letter-card" id="today-moon-card">
      <p class="label">Moon letter</p>
      <p class="glyph" id="today-moon-glyph">–</p>
      <p class="name"><span id="today-moon-name">…</span> <span class="pointed" id="today-moon-pointed"></span></p>
      <p class="meta" id="today-moon-meta"></p>
      <p id="today-moon-note"></p>
      <p class="dim small" id="today-moon-next"></p>
    </section>
  </div>

  <section class="holy-name">
    <p class="label dim small">THE DAY'S HOLY NAME</p>
    <p class="glyph" id="today-holy-glyph">–</p>
    <p class="name"><span id="today-holy-name">…</span> <span class="dim" id="today-holy-sefirah"></span></p>
    <p class="dim small">Pronounced mentally, in the mind and heart — not spoken aloud with the mouth.</p>
  </section>

  <p class="dim small" id="overview-cusp-note" hidden>
    The moon is within a degree of a sign boundary tonight, so the night letter may turn
    as the night goes on. Check again later if it matters to your practice.
  </p>

  <h2>The three mothers</h2>

  <p>
    Three mothers, and three temperaments. Alef is air, and its place is the trunk.
    Mem is water, and its place is the belly. Shin is fire, and its place is the head.
    Every sign belongs to one mother: air signs to Alef, water signs to Mem, fire signs
    to Shin — and earth signs to Mem as well, because in chapter 3 the earth was
    created from water.
  </p>

  <h2>The seven planets and their signs</h2>

  {DOUBLES.map((d) => (
    <section>
      <h3>{d.planet} — {d.glyph} {d.pointed} {d.name} · {d.day} · {d.gate}</h3>

      <table class="letters-table">
        <thead>
          <tr><th>Letter</th><th>Sign</th><th>Organ</th><th>Sense</th><th>Element</th><th>Mother</th></tr>
        </thead>
        <tbody>
          {LETTERS.filter((l) => l.planet === d.planet).map((l) => (
            <tr>
              <td class="hebrew">{l.glyph} {l.pointed} — {l.name}</td>
              <td><span class="sign-icon" style={`--icon-src: url(${SIGN_ICONS[l.sign]})`} aria-hidden="true"></span>{l.sign}<div class="dim small">{rangeOf(l)}</div></td>
              <td><span class="organ-icon" style={`--icon-src: url(${ORGAN_ICONS[l.organ]})`} aria-hidden="true"></span>{l.organ}</td>
              <td>{l.sense}</td>
              <td>{l.element}</td>
              <td class="hebrew">{MOTHER_GLYPH[l.mother]} — {l.mother}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="letters-cards">
        {LETTERS.filter((l) => l.planet === d.planet).map((l) => (
          <article class="letter-card">
            <p class="card-letter">{l.glyph} {l.pointed} — {l.name}</p>
            <p><span class="sign-icon" style={`--icon-src: url(${SIGN_ICONS[l.sign]})`} aria-hidden="true"></span>{l.sign}</p>
            <p class="dim small">{rangeOf(l)}</p>
            <p><span class="organ-icon" style={`--icon-src: url(${ORGAN_ICONS[l.organ]})`} aria-hidden="true"></span>{l.organ}</p>
            <p class="dim">{l.sense} · {l.element} · {l.mother}</p>
          </article>
        ))}
      </div>
    </section>
  ))}

  <p class="dim small">
    The organs use plain words here — first stomach is the rumen, bile is the gall,
    stomach is the abomasum, gizzard is the craw (Sefer Yetzirah, chapter 5).
  </p>

  <script>
    import { sunLetter, moonLetter, holyNameOfDay, sunRange, nextMoonIngress, DOUBLES } from '../../lib/transits.js';

    function renderOverviewToday() {
      const now = new Date();
      const dayName = now.toLocaleDateString(undefined, { weekday: 'long' });
      const dayDouble = DOUBLES.find((d) => d.day === dayName);
      const sun = sunLetter(now);
      const night = moonLetter(now);
      const holy = holyNameOfDay(now);

      const dateLine = now.toLocaleDateString(undefined, {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
      });
      document.getElementById('today-line').textContent =
        `${dateLine} · Sun in ${sun.sign} · Moon in ${night.letter.sign}`;

      if (dayDouble) {
        document.getElementById('today-day-glyph').textContent = dayDouble.glyph;
        document.getElementById('today-day-name').textContent = dayDouble.name;
        document.getElementById('today-day-pointed').textContent = dayDouble.pointed;
        document.getElementById('today-day-meta').textContent =
          `${dayDouble.planet} · ${dayDouble.day} · ${dayDouble.gate}`;
      }

      const set = (prefix, letter, meta) => {
        document.getElementById(`${prefix}-glyph`).textContent = letter.glyph;
        document.getElementById(`${prefix}-name`).textContent = letter.name;
        document.getElementById(`${prefix}-pointed`).textContent = letter.pointed;
        document.getElementById(`${prefix}-meta`).textContent = meta;
        document.getElementById(`${prefix}-note`).textContent =
          `${letter.organ}, ${letter.sense}. ${letter.note}`;
      };
      set('today-sun', sun, `${sun.sign} · ${sun.translit} · ${sunRange(sun)}`);
      set('today-moon', night.letter, `${night.letter.sign} · ${night.letter.translit}`);

      const next = nextMoonIngress(now);
      if (next) {
        const d = next.date.toLocaleDateString(undefined, { day: 'numeric', month: 'long' });
        document.getElementById('today-moon-next').textContent =
          `Moon enters ${next.sign} — ${next.letter.name}, ${d}`;
      }

      document.getElementById('today-holy-glyph').textContent = holy.pointed;
      document.getElementById('today-holy-name').textContent = holy.name;
      document.getElementById('today-holy-sefirah').textContent = `· ${holy.sefirah}`;

      if (night.nearCusp) {
        document.getElementById('overview-cusp-note').hidden = false;
      }
    }
    renderOverviewToday();
    document.addEventListener('astro:page-load', renderOverviewToday);
  </script>
</BaseLayout>

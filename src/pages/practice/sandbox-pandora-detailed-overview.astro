        chips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            chips.forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
            chip.setAttribute('aria-pressed', 'true');
            apply(chip.dataset.filter);
          });
        });
      })();
    </script>

    <script>
      (function () {
        var SIGNS = [
          { name: 'Aries',       letter: 'He',     heb: 'ה' },
          { name: 'Taurus',      letter: 'Vav',    heb: 'ו' },
          { name: 'Gemini',      letter: 'Zayin',  heb: 'ז' },
          { name: 'Cancer',      letter: 'Chet',   heb: 'ח' },
          { name: 'Leo',         letter: 'Tet',    heb: 'ט' },
          { name: 'Virgo',       letter: 'Yod',    heb: 'י' },
          { name: 'Libra',       letter: 'Lamed',  heb: 'ל' },
          { name: 'Scorpio',     letter: 'Nun',    heb: 'נ' },
          { name: 'Sagittarius', letter: 'Samekh', heb: 'ס' },
          { name: 'Capricorn',   letter: 'Ayin',   heb: 'ע' },
          { name: 'Aquarius',    letter: 'Tzadi',  heb: 'צ' },
          { name: 'Pisces',      letter: 'Qof',    heb: 'ק' }
        ];
        // Index by Date.getDay(): 0 = Sunday ... 6 = Saturday (Sefer Yetzirah, Sunday first)
        var DAYS = [
          { weekday: 'Sunday',    letter: 'Bet',   heb: 'ב', planet: 'Saturn',  holy: 'El',              holyHeb: 'אֵל' },
          { weekday: 'Monday',    letter: 'Gimel', heb: 'ג', planet: 'Jupiter', holy: 'Elohim',          holyHeb: 'אֱלֹהִים' },
          { weekday: 'Tuesday',   letter: 'Dalet', heb: 'ד', planet: 'Mars',    holy: 'YHWH',            holyHeb: 'יְהוָה' },
          { weekday: 'Wednesday', letter: 'Kaf',   heb: 'כ', planet: 'Sun',     holy: 'YHWH Tzevaot',    holyHeb: 'יְהוָה צְבָאוֹת' },
          { weekday: 'Thursday',  letter: 'Pe',    heb: 'פ', planet: 'Venus',   holy: 'Elohim Tzevaot',  holyHeb: 'אֱלֹהִים צְבָאוֹת' },
          { weekday: 'Friday',    letter: 'Resh',  heb: 'ר', planet: 'Mercury', holy: 'Shaddai',         holyHeb: 'שַׁדַּי' },
          { weekday: 'Saturday',  letter: 'Tav',   heb: 'ת', planet: 'Moon',    holy: 'Adonai',          holyHeb: 'אֲדֹנָי' }
        ];
        // Sign start dates [month, day, sign index into SIGNS], in calendar order
        var CUSPS = [
          [1, 20, 10], [2, 19, 11], [3, 21, 0], [4, 20, 1], [5, 21, 2], [6, 21, 3],
          [7, 23, 4], [8, 23, 5], [9, 23, 6], [10, 23, 7], [11, 22, 8], [12, 22, 9]
        ];
        function sunSignIndex(date) {
          var m = date.getMonth() + 1, d = date.getDate(), idx = 9; // Capricorn before Jan 20
          for (var i = 0; i < CUSPS.length; i++) {
            if (m > CUSPS[i][0] || (m === CUSPS[i][0] && d >= CUSPS[i][1])) idx = CUSPS[i][2];
          }
          return idx;
        }
        function moonSignIndex(now) {
          var d = now.getTime() / 86400000 - 10957.5; // days since J2000.0
          var rad = Math.PI / 180;
          var L = 218.3165 + 13.17639648 * d;  // mean longitude
          var M = 134.9634 + 13.06499295 * d;  // mean anomaly
          var F = 93.2721 + 13.22935024 * d;   // mean distance from ascending node
          var D = 297.8502 + 12.19074912 * d;  // mean elongation
          var Ms = 357.5291 + 0.98560028 * d;  // sun's mean anomaly
          var lon = L
            + 6.2888 * Math.sin(M * rad)
            + 1.2740 * Math.sin((2 * D - M) * rad)
            + 0.6580 * Math.sin(2 * D * rad)
            + 0.2136 * Math.sin(2 * M * rad)
            - 0.1855 * Math.sin(Ms * rad)
            - 0.1143 * Math.sin(2 * F * rad);
          lon = ((lon % 360) + 360) % 360;
          return Math.floor(lon / 30) % 12;
        }
        function set(id, text) { var el = document.getElementById(id); if (el) el.textContent = text; }
        var now = new Date();
        var day = DAYS[now.getDay()];
        var sun = SIGNS[sunSignIndex(now)];
        var moon = SIGNS[moonSignIndex(now)];
        set('today-date', now.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) + ' — the day letter, the sun letter, the moon letter, and the holy name of the day.');
        set('today-day-heb', day.heb);
        set('today-day-name', day.letter);
        set('today-day-sub', day.weekday + ' — ' + day.planet);
        set('today-sun-heb', sun.heb);
        set('today-sun-name', sun.letter);
        set('today-sun-sub', 'Sun in ' + sun.name);
        set('today-moon-heb', moon.heb);
        set('today-moon-name', moon.letter);
        set('today-moon-sub', 'Moon in ' + moon.name);
        set('today-holy-heb', day.holyHeb);
        set('today-holy-name', day.holy);
        set('today-holy-sub', day.weekday);
      })();
    </script>
    <script>
      (function () {
        var header = document.getElementById('site-header');
        var toggle = document.getElementById('nav-toggle');
        if (!header || !toggle) return;
        toggle.addEventListener('click', function () {
          var open = header.classList.toggle('nav-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        header.querySelectorAll('nav a').forEach(function (a) {
          a.addEventListener('click', function () {
            header.classList.remove('nav-open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      })();
    </script>
    <script>
      // Day/night switch: same behaviour as the BaseLayout pages — the
      // saved choice wins, otherwise the system preference; the toggle
      // flips it and persists the choice under the same 'theme' key, so
      // the setting carries across every page.
      (function () {
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) return;
        function currentTheme() {
          return root.getAttribute('data-theme') || 'day';
        }
        function applyTheme(theme) {
          localStorage.setItem('theme', theme);
          theme === 'night'
            ? root.setAttribute('data-theme', 'night')
            : root.removeAttribute('data-theme');
        }
        toggle.addEventListener('click', function () {
          applyTheme(currentTheme() === 'night' ? 'day' : 'night');
        });
      })();
    </script>
    <script>
      // Letter shapes in the theory entries: each day's double drawn as
      // points on a circle — small numbers join into their polygon, big
      // numbers read as a ring of dots, drawn bigger so the points
      // breathe. Tint is --shape-ink, the icon tint, in both themes.
      (function () {
        function shapeSVG(n, size) {
          var s = size || (n > 10 ? 60 : 44);
          var c = s / 2, r = s / 2 - 4;
          var pts = [];
          for (var i = 0; i < n; i++) {
            var a = -Math.PI / 2 + i * 2 * Math.PI / n;
            pts.push([c + r * Math.cos(a), c + r * Math.sin(a)]);
          }
          var dotR = n > 100 ? 1.5 : n > 20 ? 2 : 3;
          var inner = '';
          if (n === 2) {
            inner += '<line x1="' + pts[0][0].toFixed(1) + '" y1="' + pts[0][1].toFixed(1) + '" x2="' + pts[1][0].toFixed(1) + '" y2="' + pts[1][1].toFixed(1) + '" stroke="currentColor" stroke-width="1.5"/>';
          } else if (n > 2 && n <= 10) {
            inner += '<polygon points="' + pts.map(function (p) { return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ') + '" fill="none" stroke="currentColor" stroke-width="1.5"/>';
          }
          pts.forEach(function (p) {
            inner += '<circle cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="' + dotR + '" fill="currentColor"/>';
          });
          return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 ' + s + ' ' + s + '" aria-hidden="true">' + inner + '</svg>';
        }
        document.querySelectorAll('.shape-mark[data-shape]').forEach(function (el) {
          var n = parseInt(el.getAttribute('data-shape'), 10);
          var size = n > 20 ? 72 : n > 10 ? 60 : 44;
          el.innerHTML = shapeSVG(n, size);
        });
      })();
    </script>
    <script>
      // Gematria values on every letter, from the shared letters file.
      // The seven day entries already carry their value in the shape
      // caption, so this covers the week strip, the mothers, the table,
      // and the Today grid. It runs last, after the main script has
      // filled the Today values.
      (function () {
        var data = JSON.parse(document.getElementById('gematria-data').textContent);
        var GEMATRIA = data.gematria, GLYPHS = data.glyphs, POINTED = data.pointed;
        function gemTag(name) {
          var n = GEMATRIA[name] || 0;
          return n ? ' · ' + n : '';
        }
        // Week strip: the seven doubles, by glyph. The strip carries
        // no letter name, so the name goes in with its pointing.
        document.querySelectorAll('.week .day').forEach(function (d) {
          var heb = d.querySelector('.heb');
          if (!heb) return;
          var name = GLYPHS[heb.textContent.trim()];
          if (!name || !GEMATRIA[name]) return;
          var nm = document.createElement('span');
          nm.className = 'pname';
          nm.textContent = name + ' — ' + POINTED[name];
          d.appendChild(nm);
          var s = document.createElement('span');
          s.className = 'gem';
          s.textContent = 'Gematria ' + GEMATRIA[name];
          d.appendChild(s);
        });
        // The three mothers, by the name in the heading. The name is
        // already there, so the pointed name joins the gematria line.
        document.querySelectorAll('.mothers .day').forEach(function (d) {
          var head = d.querySelector('.dname');
          if (!head) return;
          var name = head.textContent.split(' — ')[0].trim();
          if (!GEMATRIA[name]) return;
          var s = document.createElement('span');
          s.className = 'gem';
          s.textContent = POINTED[name] + ' · Gematria ' + GEMATRIA[name];
          d.appendChild(s);
        });
        // The table: sign letters and mothers.
        document.querySelectorAll('#main-table .sign-letter-cell').forEach(function (cell) {
          var name = cell.textContent.trim().split(/\s+/)[0];
          cell.insertAdjacentHTML('beforeend', '<span class="heb heb-md">' + POINTED[name] + '</span><span class="gem-inline">' + gemTag(name) + '</span>');
        });
        // The table: planet letters.
        document.querySelectorAll('#main-table .planet-letter-cell .lname').forEach(function (el) {
          var m = el.textContent.match(/Planet letter — (\w+)/);
          if (m) el.textContent = el.textContent.replace(m[1] + ',', m[1] + ' ' + POINTED[m[1]] + ',') + gemTag(m[1]);
        });
        // Today grid: the main script filled the names before this one ran.
        ['today-day-name', 'today-sun-name', 'today-moon-name'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el && el.textContent.trim() !== '—') {
            var nm = el.textContent.trim();
            el.textContent = nm + ' ' + POINTED[nm] + gemTag(nm);
          }
        });
      })();
    </script>
  </body>

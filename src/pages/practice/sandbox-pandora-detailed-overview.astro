              var show = filter === 'all' || r.dataset.element === filter;
              r.classList.toggle('hidden-row', !show);
              if (show) planetHasVisible[r._planet] = true;
            }
          });
          rows.forEach(function (r) {
            if (r.classList.contains('planet-row')) {
              r.classList.toggle('dimmed', filter !== 'all' && !planetHasVisible[r.dataset.planet]);
            }
          });

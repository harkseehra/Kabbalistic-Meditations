---
import { GEMATRIA, GLYPHS, POINTED } from '../../lib/letters.js';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>Kabbalistic Pokedox</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baskervville:ital,wght@0,400;0,500;0,700;1,400&family=Oswald:wght@400;500;600&family=IM+Fell+French+Canon:ital@0;1&family=Frank+Ruhl+Libre:wght@400;500&family=Redaction+10&family=Teko:wght@500;600&display=swap" rel="stylesheet" />
    <!-- Apply saved theme before paint; day is the default, night follows
         the saved choice or the system preference -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const night = saved === 'night' || (saved !== 'day' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (night) document.documentElement.setAttribute('data-theme', 'night');
    </script>
    <style is:global>
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2.25rem; }
      * { box-sizing: border-box; }
      :root {
        color-scheme: light dark;
        /* Type scale — Material Design 3 role ratios against the 21.6px
           body: headline large 2.0x, headline medium 1.75x, headline
           small 1.5x, title large 1.375x. These tokens match
           src/styles/tokens.css exactly; the html root is 1.35rem so 1rem
           here is the base size on this page, same as BaseLayout pages. */
        --text-xs: 0.86rem;
        --text-sm: 1.08rem;
        --text-base: 1.35rem;
        --text-lg: 1.375rem;
        --text-xl: 1.5rem;
        --text-2xl: 1.75rem;
        --text-3xl: 2.0rem;
        /* Spacing — 8-point scale. Every gap on the page is one of these. */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 16px;
        --space-4: 24px;
        --space-5: 32px;
        --space-6: 48px;
        --space-7: 64px;
        /* Radius — cards 16px, buttons 10px, matching tokens.css. */
        --radius-card: 16px;
        --radius-sm: 10px;
        /* Motion — one clean ease-out everywhere. */
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --bg: #f7f5f0;
        --surface: #ffffff;
        --surface-2: #efede6;
        --ink: #1c1e26;
        --ink-soft: #4a4d59;
        --line: #d8d4c8;
        --accent: #191970;
        --accent-soft: #e3e4f2;
        --heb: #191970;
        --shape-ink: #191970;
        --fire: #b34a1f; --fire-bg: #fbe9df;
        --earth: #6d5a2e; --earth-bg: #f1ead3;
        --air: #3e6b7a; --air-bg: #e0eef2;
        --water: #2c4f9e; --water-bg: #e0e8fa;
        /* Header — same flat bar as the rest of the site. */
        --header-bg: #005b96;
        --header-ink: #ffffff;
        --header-btn-bg: rgba(255, 255, 255, 0.12);
        --header-btn-border: rgba(255, 255, 255, 0.35);
        --header-active-bg: #ffffff;
        --header-active-ink: #005b96;
      }
      /* Night — driven by data-theme="night" on <html>, set by the head
         script from the saved choice or the system preference, and flipped
         by the floating toggle. A manual choice always wins over the
         system theme. */
      :root[data-theme="night"] {
          /* Royal Ink night — same palette as tokens.css, in this page's
             variable names. Element hues stay as they are: they are
             categorical (fire/earth/air/water identity), not theme. */
          --bg: #0D1330;
          --surface: #171E42;
          --surface-2: #1C2450;
          --ink: #E3E6F0;
          --ink-soft: #AEB8D6;
          --line: #2E3A6B;
          --accent: #8AA5FF;
          --accent-soft: #1B2452;
          --heb: #F5F7FF;
          --shape-ink: #AEBFFF;
          --fire: #eda27c; --fire-bg: #3a2a22;
          --earth: #d9c48a; --earth-bg: #37321f;
          --air: #9fd3e0; --air-bg: #22383d;
          --water: #a9c2f5; --water-bg: #232f47;
          /* Header — flat royal blue by night. */
          --header-bg: #1E40AF;
          --header-ink: #ffffff;
          --header-btn-bg: rgba(255, 255, 255, 0.12);
          --header-btn-border: rgba(255, 255, 255, 0.35);
          --header-active-bg: #ffffff;
          --header-active-ink: #1E40AF;
      }
      html { font-size: 1.35rem; -webkit-font-smoothing: antialiased; }

      /* Letter shapes — a letter's gematria drawn as points on a circle:
         small numbers join into their polygon, big numbers read as a ring
         of dots. The tint is the icon tint, so the marks sit inside the
         design in both themes. */
      .shape-mark { color: var(--shape-ink); display: inline-flex; flex: none; }
      .shape-mark svg { display: block; }
      .gem { display: block; font-family: "Oswald", sans-serif; font-size: 0.85rem; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: var(--space-1); }
      .gem-inline { font-size: 0.85rem; color: var(--ink-soft); }
      .shape-row { display: flex; align-items: center; gap: var(--space-3); margin: var(--space-2) 0 var(--space-3); }
      .shape-caption { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Baskervville", "IM Fell French Canon", Georgia, serif;
        font-size: 1rem;
        line-height: 1.6;
        letter-spacing: 0.02em;
        word-spacing: 0.1em;
        transition: background 0.5s var(--ease-out), color 0.5s var(--ease-out), border-color 0.5s var(--ease-out);
      }
      /* Site header — the same bar as the rest of the site. Entrance is a
         plain fade only (opacity, no movement) — the menu bar animation
         is deliberately subtle. */
      @keyframes header-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      #site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        padding: 0.5rem 1.5rem;
        background: var(--header-bg);
        border-bottom: 1px solid rgba(0, 0, 0, 0.15);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        color: var(--header-ink);
        animation: header-in 500ms var(--ease-out) both;
      }
      #site-header .site-name { justify-self: start; text-decoration: none; }
      #site-header .site-wordmark { font-family: "Redaction 10", "Cormorant Garamond", Georgia, serif; font-size: var(--text-sm); letter-spacing: 0.08em; color: var(--header-ink); }
      #site-header .site-wordmark .cursor { color: var(--header-ink); }
      #site-header nav { display: flex; gap: 0.6rem; justify-self: end; }
      #site-header nav a {
        font-family: "Teko", "Oswald", sans-serif;
        font-size: var(--text-sm);
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.45rem 1.1rem;
        border: 1px solid var(--header-btn-border);
        border-radius: var(--radius-sm);
        background-color: var(--header-btn-bg);
        color: var(--header-ink);
        text-decoration: none;
        transition: background-color 250ms var(--ease-out), border-color 250ms var(--ease-out);
      }
      #site-header nav a:hover { background-color: rgba(255, 255, 255, 0.22); border-color: var(--header-ink); }
      #site-header nav a.active {
        background-color: var(--header-active-bg);
        border-color: transparent;
        color: var(--header-active-ink);
      }
      #site-header nav a:active { background-color: rgba(255, 255, 255, 0.18); }
      #site-header nav a:focus-visible { outline: 2px solid var(--header-ink); outline-offset: 2px; }
      .nav-toggle {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--header-btn-border);
        border-radius: var(--radius-sm);
        background: var(--header-btn-bg);
        color: var(--header-ink);
        cursor: pointer;
        justify-self: end;
      }
      .nav-toggle span {
        display: block;
        width: 1.25rem;
        height: 2px;
        background: currentColor;
        border-radius: 1px;
      }
      @media (max-width: 640px) {
        #site-header { grid-template-columns: 1fr auto; row-gap: 0.5rem; padding: 0.6rem 1rem; }
        #site-header .site-wordmark { font-size: var(--text-xs); }
        .nav-toggle { display: inline-flex; }
        #site-header nav { display: none; grid-column: 1 / -1; grid-row: 2; flex-direction: column; align-items: flex-end; gap: 0.4rem; justify-content: flex-start; }
        #site-header.nav-open nav { display: flex; }
        #site-header nav a { padding: 0.35rem 0.8rem; }
      }

      /* Theme toggle: a floating button near the right edge of the screen,
         vertically centred, gently bobbing — detached from the edge, not
         stuck to it. Same button as the BaseLayout pages. */
      @keyframes float-y {
        0%, 100% { translate: 0 calc(-50% - 3px); }
        50%     { translate: 0 calc(-50% + 3px); }
      }
      #theme-toggle {
        position: fixed;
        right: 1rem;
        top: 50%;
        translate: 0 -50%;
        animation: float-y 5s ease-in-out infinite;
        z-index: 20;
        background-color: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 0.45rem;
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        color: var(--ink);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
        transition: transform 150ms var(--ease-out), background 200ms var(--ease-out), border-color 200ms var(--ease-out);
      }
      #theme-toggle:hover { transform: translateX(-2px); }
      #theme-toggle:active { transition-duration: 100ms; transform: scale(0.97); }
      #theme-toggle:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
      }
      #theme-toggle svg { width: 1.26rem; height: 1.26rem; display: block; color: var(--ink); }
      #theme-toggle .icon-moon { display: none; }
      [data-theme="night"] #theme-toggle .icon-sun { display: none; }
      [data-theme="night"] #theme-toggle .icon-moon { display: block; }
      @media (hover: none) {
        #theme-toggle:hover { transform: none; }
        .day:hover { transform: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        #theme-toggle { animation: none; }
        .day { animation: none; }
        *, *::before, *::after { transition-duration: 0.001ms !important; }
      }

      .wrap { max-width: 1200px; margin: 0 auto; padding: var(--space-7) var(--space-6) var(--space-7); }
      h1, h2, h3 { font-family: "Teko", "Oswald", "Arial Narrow", sans-serif; letter-spacing: .01em; word-spacing: normal; }
      h1 { font-size: var(--text-3xl); font-weight: 600; letter-spacing: .01em; line-height: 1.2; margin: 0 0 var(--space-2); }
      h2 { font-size: var(--text-2xl); font-weight: 600; margin: var(--space-7) 0 var(--space-3); }
      h3 { font-size: var(--text-xl); font-weight: 600; line-height: 1.2; margin: var(--space-6) 0 var(--space-2); }
      p { margin: 0 0 var(--space-3); max-width: 31rem; }
      .lede { color: var(--ink-soft); font-size: var(--text-lg); }
      .heb { font-family: "Frank Ruhl Libre", serif; color: var(--heb); font-weight: 500; letter-spacing: 0; word-spacing: normal; }
      .heb-big { font-size: var(--text-2xl); line-height: 1; }
      .heb-md { font-size: var(--text-lg); line-height: 1; }

      /* Week strip */
      .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-2); margin: var(--space-3) 0 var(--space-4); }
      .day {
        background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
        padding: var(--space-4); text-align: center;
        /* Card lift: MD3 medium2 (300ms) on the site's one ease-out. */
        transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out), background-color 300ms var(--ease-out), border-color 300ms var(--ease-out);
      }
      .day:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.20);
      }

      /* Card entrance — staggered fade-up on page load (MD3
         emphasized-decelerate, medium4 400ms; 60ms stagger). Fill is
         backwards, so the hover lift still works once the entrance ends. */
      @keyframes card-in {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .day { animation: card-in 400ms var(--ease-out) backwards; }
      .week > :nth-child(2), .today-grid > :nth-child(2), .mothers > :nth-child(2) { animation-delay: 60ms; }
      .week > :nth-child(3), .today-grid > :nth-child(3), .mothers > :nth-child(3) { animation-delay: 120ms; }
      .week > :nth-child(4), .today-grid > :nth-child(4) { animation-delay: 180ms; }
      .week > :nth-child(5) { animation-delay: 240ms; }
      .week > :nth-child(6) { animation-delay: 300ms; }
      .week > :nth-child(7) { animation-delay: 360ms; }
      .day .dname { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); display: block; }
      .day .pname { display: block; font-size: 1rem; margin-top: var(--space-1); }
      .day .gate { display: block; font-size: var(--text-sm); color: var(--ink-soft); margin-top: var(--space-1); }
      .day .heb-big { display: block; margin-top: var(--space-2); }
      @media (max-width: 640px) { .week { grid-template-columns: repeat(4, 1fr); } }

      /* Today */
      .today-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-4); }
      @media (max-width: 640px) { .today-grid { grid-template-columns: repeat(2, 1fr); } }

      /* Three mothers */
      .mothers { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin: var(--space-3) 0 var(--space-4); }
      @media (max-width: 640px) { .mothers { grid-template-columns: 1fr; } }

      /* Filters */
      .filters { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-5) 0 var(--space-4); align-items: center; }
      .filters span { font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); margin-right: var(--space-1); }
      .chip {
        font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .03em;
        padding: var(--space-2) var(--space-3); border-radius: 999px; cursor: pointer;
        border: 1px solid var(--line); background: var(--surface); color: var(--ink);
        min-height: 2.5rem;
        transition: transform 150ms var(--ease-out), border-color 200ms var(--ease-out), background-color 200ms var(--ease-out);
      }
      .chip:hover { border-color: var(--ink); transform: translateY(-1px); }
      .chip:active { transition-duration: 100ms; transform: scale(0.97); }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
      [data-theme="night"] .chip[aria-pressed="true"] { color: #0D1330; }

      /* Table */
      .table-scroll { border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden; background: var(--surface); }
      table { width: 100%; border-collapse: collapse; }
      thead th {
        font-family: "Oswald", sans-serif; font-weight: 500; font-size: var(--text-sm); letter-spacing: .09em; text-transform: uppercase;
        text-align: left; color: var(--ink-soft); background: var(--surface-2);
        padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--line);
      }
      tr.planet-row td {
        background: var(--accent-soft); padding: var(--space-3); border-top: 2px solid var(--line);
      }
      tr.planet-row:first-child td { border-top: none; }
      .planet-name { font-family: "Teko", "Oswald", sans-serif; font-size: var(--text-lg); font-weight: 600; letter-spacing: .02em; }
      .planet-day { color: var(--ink-soft); font-size: var(--text-sm); }
      .planet-letter-cell { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
      .planet-letter-cell .lname { font-size: 1rem; }
      .planet-gate { color: var(--ink-soft); font-size: var(--text-sm); }
      tr.sign-row td { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--line); vertical-align: middle; }
      tr.sign-row td:first-child { padding-left: var(--space-5); }
      .sign-name { font-size: 1rem; }
      .sign-letter-cell { display: flex; align-items: center; gap: var(--space-2); }
      .elem {
        display: inline-block; font-family: "Oswald", sans-serif; font-size: var(--text-xs); letter-spacing: .07em; text-transform: uppercase;
        padding: var(--space-1) 0.75rem; border-radius: 999px; white-space: nowrap;
      }
      .elem-fire { background: var(--fire-bg); color: var(--fire); }
      .elem-earth { background: var(--earth-bg); color: var(--earth); }
      .elem-air { background: var(--air-bg); color: var(--air); }
      .elem-water { background: var(--water-bg); color: var(--water); }
      tr.hidden-row { display: none; }
      .dimmed { opacity: .35; }

      .note { color: var(--ink-soft); font-size: var(--text-sm); }
      .src { border-top: 1px solid var(--line); margin-top: var(--space-7); padding-top: var(--space-3); color: var(--ink-soft); font-size: var(--text-sm); }
      .src p { margin-bottom: var(--space-2); }

      /* Mobile: table becomes stacked blocks */
      @media (max-width: 680px) {
        table, thead, tbody, tr, td { display: block; width: 100%; }
        thead { display: none; }
        tr.planet-row td { border-top: 2px solid var(--line); }
        tr.sign-row { border-top: 1px solid var(--line); padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4); }
        tr.sign-row td { border-top: none; padding: var(--space-1) 0; }
        tr.sign-row td:first-child { padding-left: 0; }
        tr.sign-row td::before {
          content: attr(data-label); display: inline-block; min-width: 6.2rem;
          font-family: "Oswald", sans-serif; font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft);
        }
        tr.sign-row td.cell-sign::before { content: ""; min-width: 0; }
        .sign-name { font-size: 1rem; }
      }
    </style>
  </head>
  <body>
    <header id="site-header">
      <a class="site-name" href="../../"><span class="site-wordmark">KABBALISTIC MEDITATIONS<span class="cursor">▌</span></span></a>
      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span></span><span></span><span></span></button>
      <nav id="site-nav">
        <a href="../../">today</a>
        <a href="../../current-horoscope/">horoscope</a>
        <a href="../../birth-chart/">birth chart</a>
        <a href="../../codex/">codex</a>
        <a href="../" class="active">practice</a>
        <a href="../../prayer/">prayer</a>
        <a href="../../blog/">blog</a>
      </nav>
    </header>
    <!-- Day/night switch: a plain side button on the right edge of the screen, vertically centred -->
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle day and night mode" title="Toggle day and night mode">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g fill="currentColor"><path d="M11.17 6.06 12.83 6.06 12 2.5Z"/><path d="M15.61 7.21 16.79 8.39 18.72 5.28Z"/><path d="M17.94 11.17 17.94 12.83 21.5 12Z"/><path d="M16.79 15.61 15.61 16.79 18.72 18.72Z"/><path d="M12.83 17.94 11.17 17.94 12 21.5Z"/><path d="M8.39 16.79 7.21 15.61 5.28 18.72Z"/><path d="M6.06 12.83 6.06 11.17 2.5 12Z"/><path d="M7.21 8.39 8.39 7.21 5.28 5.28Z"/></g></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/><path fill="currentColor" d="M18.5 3.5 19.2 5.3 21 6 19.2 6.7 18.5 8.5 17.8 6.7 16 6 17.8 5.3Z"/></svg>
    </button>
    <main class="wrap">
      <h1>Kabbalistic Pokedox</h1>
      <p class="lede">The Pokedox — the whole system in one place, for study and practice. The letters, the days, the signs, the body parts, the senses, and the mothers — and the theory of when each day is strongest, and what to practice then.</p>

      <p>Read it top down. The planet is the parent. Its letter is one of the seven doubles of Sefer Yetzirah, chapter 4 — the letter made king over that planet in the world, over one day in the year, and over one gate in the soul. Under the planet sit its signs, the signs it rules. Each sign carries one of the twelve simple letters of chapter 5, and that letter is king over a stretch of dates in the year, a body part in the person, and a sense — a faculty — in the soul.</p>

      <p>So every planet stacks in layers. Take the Sun. Its own letter is Kaf, the double. Its day is Wednesday, when the day's letter is also Kaf, and the Sun is doubled. Its gate in the soul is the left ear. Its sign is Leo, and Leo's letter is Tet, the simple — king over the dates Jul 23 – Aug 22, the right kidney, and eating. One planet, its layers each in its place.</p>

      <h2>Today</h2>
      <p id="today-date" class="note">Today's values, worked out from the date on your device.</p>
      <div class="today-grid" aria-label="Today's horoscopic values">
        <div class="day">
          <span class="dname">Day letter</span>
          <span class="heb heb-big" id="today-day-heb">—</span>
          <span class="pname" id="today-day-name">—</span>
          <span class="gate" id="today-day-sub">—</span>
        </div>
        <div class="day">
          <span class="dname">Sun letter</span>
          <span class="heb heb-big" id="today-sun-heb">—</span>
          <span class="pname" id="today-sun-name">—</span>
          <span class="gate" id="today-sun-sub">—</span>
        </div>
        <div class="day">
          <span class="dname">Moon letter</span>
